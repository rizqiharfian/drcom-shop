<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Claim Garansi</title>

    <link rel="icon" href="/drcom.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            padding-top: 4px;
        }

        .select2-selection__rendered {
            line-height: 28px !important;
        }

        .select2-selection__arrow {
            height: 38px !important;
        }

        .select2-results__option {
            padding: 10px;
        }

        .table td,
        .table th {
            vertical-align: middle;
        }

        .produk-col {
            min-width: 320px;
            max-width: 420px;
            white-space: normal;
        }

        .keluhan-col {
            min-width: 180px;
            max-width: 250px;
            white-space: pre-line;
        }

        .foto-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-width: 170px;
        }

        .foto-list img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            transition: .2s;
        }

        .foto-list img:hover {
            transform: scale(1.08);
        }

        .aksi {
            display: flex;
            gap: 8px;
            justify-content: center;
            align-items: center;
            min-width: 150px;
        }

        .badge-status {
            font-size: 14px;
            padding: 8px 14px;
        }

        .customer-col {
            min-width: 120px;
        }

        .tanggal-col {
            min-width: 140px;
        }
    </style>

</head>

<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
        <a class="navbar-brand" href="/">Manajemen Toko</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
            <% const currentPath=typeof path !=='undefined' ? path : '/' ; %>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Beranda</a>
                </li>
                <li class="nav-item"><a class="nav-link" href="/seller">Seller</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/claim-garansi' ? 'active' : '' %>"
                    href="/claim-garansi">Claim Garansi</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-masuk' ? 'active' : '' %>"
                    href="/barang-masuk">Barang Masuk</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar' ? 'active' : '' %>"
                    href="/barang-keluar">Barang Keluar</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar-alex' ? 'active' : '' %>"
                    href="/barang-keluar-alex">Barang Keluar Alex</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-hilang' ? 'active' : '' %>"
                    href="/barang-hilang">Barang Hilang</a></li>
                <li class="nav-item"><a class="nav-link <%= currentPath === '/produk' ? 'active' : '' %>"
                    href="/produk">Produk</a></li>
                <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Sparepart</a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/sparepart">Master Sparepart</a></li>
                    <!-- <li><a class="dropdown-item" href="/sparepart-masuk">Sparepart Masuk</a></li> -->
                </ul>
                </li>
            </ul>
        </div>
        </div>
    </nav>

    <div class="container mt-4">

        <h2 class="mb-4">
            Claim Garansi
        </h2>

        <div class="card">

            <div class="card-header bg-primary text-white">

                Input Claim Garansi

            </div>

            <div class="card-body">

                <form action="/claim-garansi" method="POST" enctype="multipart/form-data">

                    <div class="mb-3">

                        <label>Produk</label>

                        <select name="produk_id" id="produkSelect" class="form-select" required>

                            <option value="">
                                Cari Produk...
                            </option>

                            <% produk.forEach(function(p){ %>

                                <option value="<%= p.id %>">

                                    <%= p.kode_produk %> |
                                        <%= p.nama %> |
                                            JKT : <%= p.stok_jakarta %> |
                                                SMG : <%= p.stok_semarang %>

                                </option>

                                <% }) %>

                        </select>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <label>Nama Customer</label>

                            <input type="text" name="customer" class="form-control" required>

                        </div>

                    </div>

                    <div class="mt-3">

                        <label>Keluhan</label>

                        <textarea name="keluhan" class="form-control" rows="3"></textarea>

                    </div>

                    <div class="mt-3">

                        <label>Upload Foto</label>

                        <input type="file" name="gambar" class="form-control" accept="image/*" multiple>

                        <small class="text-muted">
                            Bisa memilih lebih dari satu foto.
                        </small>

                    </div>

                    <div class="mt-4">

                        <button class="btn btn-success">

                            Simpan

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <hr class="my-4">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h4 class="mb-0">Riwayat Claim Garansi</h4>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <form action="/export/claim-garansi/pdf"
                    method="GET"
                    class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">Periode Export</label>
                        <select name="periode" id="periodeExport" class="form-select">
                            <option value="harian">Harian</option>
                            <option value="mingguan">Mingguan</option>
                            <option value="bulanan">Bulanan</option>
                        </select>
                    </div>

                    <div class="col-md-3" id="tanggalWrapper">
                        <label class="form-label" id="labelTanggal">
                            Pilih Tanggal
                        </label>
                        <input type="date"
                            name="tanggal"
                            id="tanggalExport"
                            class="form-control"
                            value="<%= new Date().toLocaleDateString('en-CA') %>">
                    </div>

                    <div class="col-md-3" id="bulanWrapper" style="display:none;">
                        <label class="form-label">Pilih Bulan</label>
                        <input type="month"
                            name="bulan"
                            id="bulanExport"
                            class="form-control"
                            value="<%= new Date().toISOString().slice(0, 7) %>">
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-danger w-100">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Export PDF
                        </button>
                    </div>

                </form>

                <small class="text-muted d-block mt-3" id="keteranganExport">
                    Export data Claim Garansi berdasarkan tanggal yang dipilih.
                </small>
            </div>
        </div>

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">

                <tr>

                    <th>No</th>

                    <th>Produk</th>

                    <th>Customer</th>

                    <th>Foto</th>

                    <th>Keluhan</th>

                    <th>Status</th>

                    <th>Tanggal</th>

                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(claimList.length){ %>

                    <% claimList.forEach((c,index)=>{ %>

                        <tr>

                            <td>
                                <%= ((currentPage - 1) * 10) + index + 1 %>
                            </td>

                            <td class="produk-col">

                                <strong>
                                    <%= c.kode_produk %>
                                </strong>
                                <br>
                                <small class="text-muted">
                                    <%= c.nama_produk %>
                                </small>

                            </td>

                            <td>
                                <%= c.customer %>
                            </td>

                            <td>

                                <% if(c.gambar){ %>

                                    <div class="foto-list">

                                        <% c.gambar.split(',').forEach(function(img){ %>

                                            <a href="/media/<%= img.trim() %>" target="_blank">

                                                <img src="/media/<%= img.trim() %>" class="img-thumbnail">

                                            </a>

                                            <% }) %>

                                    </div>

                                    <% }else{ %>

                                        -

                                        <% } %>

                            </td>

                            <td>
                                <%= c.keluhan %>
                            </td>

                            <td>

                                <span class="badge badge-status
                                <%= c.status === 'Menunggu'
                                    ? 'bg-danger'
                                    : c.status === 'Proses'
                                    ? 'bg-warning'
                                    : c.status === 'Gagal'
                                    ? 'bg-danger'
                                    : c.status === 'Selesai'
                                    ? 'bg-success'
                                    : 'bg-secondary' %>">

                                    <%= c.status %>

                                </span>

                            </td>

                            <td class="tanggal-col">

                                <%= new Date(c.created_at).toLocaleDateString('id-ID') %>
                                    <br>
                                    <small class="text-muted">
                                        <%= new Date(c.created_at).toLocaleTimeString('id-ID') %>
                                    </small>

                            </td>

                            <td>

                                <div class="aksi">

                                    <a href="/claim-garansi/edit/<%= c.id %>" class="btn btn-warning btn-sm">

                                        ✏ Edit

                                    </a>

                                    <form action="/claim-garansi/delete/<%= c.id %>" method="POST"
                                        onsubmit="return confirm('Hapus data ini?')">

                                        <button class="btn btn-danger btn-sm">

                                            🗑 Hapus

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        <% }) %>

                            <% }else{ %>

                                <tr>

                                    <td colspan="8" class="text-center">

                                        Belum ada data

                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>
        <% if (totalPages > 1) { %>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">

                <div class="text-muted">
                    Halaman <strong><%= currentPage %></strong>
                    dari <strong><%= totalPages %></strong>
                </div>

                <nav>
                    <ul class="pagination mb-0">

                        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                            <a class="page-link"
                            href="/claim-garansi?page=<%= currentPage - 1 %>">
                                Sebelumnya
                            </a>
                        </li>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                <a class="page-link"
                                href="/claim-garansi?page=<%= i %>">
                                    <%= i %>
                                </a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                            <a class="page-link"
                            href="/claim-garansi?page=<%= currentPage + 1 %>">
                                Berikutnya
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>
        <% } %>

    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {

            $('#produkSelect').select2({

                placeholder: "🔍 Cari kode atau nama produk",

                allowClear: true,

                width: '100%'

            });

        });
    </script>
</body>

</html>