<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Claim Garansi</title>

    <link rel="icon" href="/drcom.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            padding-top: 4px;
        }

        .select2-selection__rendered {
            line-height: 28px !important;
        }

        .select2-selection__arrow {
            height: 38px !important;
        }

        .select2-results__option {
            padding: 10px;
        }

        .table td,
        .table th {
            vertical-align: middle;
        }

        .produk-col {
            min-width: 320px;
            max-width: 420px;
            white-space: normal;
        }

        .keluhan-col {
            min-width: 180px;
            max-width: 250px;
            white-space: pre-line;
        }

        .foto-list {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            max-width: 170px;
        }

        .foto-list img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            transition: .2s;
        }

        .foto-list img:hover {
            transform: scale(1.08);
        }

        .aksi {
            display: flex;
            gap: 8px;
            justify-content: center;
            align-items: center;
            min-width: 150px;
        }

        .badge-status {
            font-size: 14px;
            padding: 8px 14px;
        }

        .customer-col {
            min-width: 120px;
        }

        .tanggal-col {
            min-width: 140px;
        }
    </style>

</head>

<body>

    <div class="container mt-4">

        <h2 class="mb-4">
            Claim Garansi
        </h2>

        <div class="card">

            <div class="card-header bg-primary text-white">

                Input Claim Garansi

            </div>

            <div class="card-body">

                <form action="/claim-garansi" method="POST" enctype="multipart/form-data">

                    <div class="mb-3">

                        <label>Produk</label>

                        <select name="produk_id" id="produkSelect" class="form-select" required>

                            <option value="">
                                Cari Produk...
                            </option>

                            <% produk.forEach(function(p){ %>

                                <option value="<%= p.id %>">

                                    <%= p.kode_produk %> |
                                        <%= p.nama %> |
                                            JKT : <%= p.stok_jakarta %> |
                                                SMG : <%= p.stok_semarang %>

                                </option>

                                <% }) %>

                        </select>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <label>Nama Customer</label>

                            <input type="text" name="customer" class="form-control" required>

                        </div>

                    </div>

                    <div class="mt-3">

                        <label>Keluhan</label>

                        <textarea name="keluhan" class="form-control" rows="3"></textarea>

                    </div>

                    <div class="mt-3">

                        <label>Upload Foto</label>

                        <input type="file" name="gambar" class="form-control" accept="image/*" multiple>

                        <small class="text-muted">
                            Bisa memilih lebih dari satu foto.
                        </small>

                    </div>

                    <div class="mt-4">

                        <button class="btn btn-success">

                            Simpan

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <hr class="my-4">

        <h4>Riwayat Claim Garansi</h4>

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-dark">

                <tr>

                    <th>No</th>

                    <th>Produk</th>

                    <th>Customer</th>

                    <th>Foto</th>

                    <th>Keluhan</th>

                    <th>Status</th>

                    <th>Tanggal</th>

                    <th>Aksi</th>

                </tr>

            </thead>

            <tbody>

                <% if(claimList.length){ %>

                    <% claimList.forEach((c,index)=>{ %>

                        <tr>

                            <td>
                                <%= index+1 %>
                            </td>

                            <td class="produk-col">

                                <strong>
                                    <%= c.kode_produk %>
                                </strong>
                                <br>
                                <small class="text-muted">
                                    <%= c.nama_produk %>
                                </small>

                            </td>

                            <td>
                                <%= c.customer %>
                            </td>

                            <td>

                                <% if(c.gambar){ %>

                                    <div class="foto-list">

                                        <% c.gambar.split(',').forEach(function(img){ %>

                                            <a href="/media/<%= img.trim() %>" target="_blank">

                                                <img src="/media/<%= img.trim() %>" class="img-thumbnail">

                                            </a>

                                            <% }) %>

                                    </div>

                                    <% }else{ %>

                                        -

                                        <% } %>

                            </td>

                            <td>
                                <%= c.keluhan %>
                            </td>

                            <td>

                                <span class="badge badge-status
                                <%= c.status === 'Menunggu'
                                    ? 'bg-danger'
                                    : c.status === 'Proses'
                                    ? 'bg-warning'
                                    : c.status === 'Selesai'
                                    ? 'bg-success'
                                    : 'bg-secondary' %>">

                                    <%= c.status %>

                                </span>

                            </td>

                            <td class="tanggal-col">

                                <%= new Date(c.created_at).toLocaleDateString('id-ID') %>
                                    <br>
                                    <small class="text-muted">
                                        <%= new Date(c.created_at).toLocaleTimeString('id-ID') %>
                                    </small>

                            </td>

                            <td>

                                <div class="aksi">

                                    <a href="/claim-garansi/edit/<%= c.id %>" class="btn btn-warning btn-sm">

                                        ✏ Edit

                                    </a>

                                    <form action="/claim-garansi/delete/<%= c.id %>" method="POST"
                                        onsubmit="return confirm('Hapus data ini?')">

                                        <button class="btn btn-danger btn-sm">

                                            🗑 Hapus

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        <% }) %>

                            <% }else{ %>

                                <tr>

                                    <td colspan="7" class="text-center">

                                        Belum ada data

                                    </td>

                                </tr>

                                <% } %>

            </tbody>

        </table>

    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(function () {

            $('#produkSelect').select2({

                placeholder: "🔍 Cari kode atau nama produk",

                allowClear: true,

                width: '100%'

            });

        });
    </script>
</body>

</html>