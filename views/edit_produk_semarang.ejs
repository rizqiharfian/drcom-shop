<!DOCTYPE html>
<html>
<head>
    <title>Edit Produk Semarang</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-4">

    <div class="card">

        <div class="card-header bg-warning">
            Edit Produk Semarang
        </div>

        <div class="card-body">

            <form
                action="/stok-semarang/edit/<%= produk.id %>"
                method="POST">

                <div class="mb-3">

                    <label>Kode Produk</label>

                    <input
                        type="text"
                        name="kode_produk"
                        class="form-control"
                        value="<%= produk.kode_produk %>">

                </div>

                <div class="mb-3">

                    <label>Nama Produk</label>

                    <input
                        type="text"
                        name="nama"
                        class="form-control"
                        value="<%= produk.nama %>">

                </div>

                <div class="mb-3">

                    <label>Posisi</label>

                    <input
                        type="text"
                        name="posisi"
                        class="form-control"
                        value="<%= produk.posisi || '' %>">

                </div>

                <div class="mb-3">

                    <label>Keterangan</label>

                    <textarea
                        name="keterangan"
                        class="form-control"><%= produk.keterangan || '' %></textarea>

                </div>

                <div class="mb-3">

                    <label>Stok Semarang</label>

                    <input
                        type="number"
                        name="stok_semarang"
                        class="form-control"
                        value="<%= produk.stok_semarang %>">

                </div>

                <button
                    type="submit"
                    class="btn btn-success">

                    Simpan

                </button>

                <a
                    href="/stok/semarang"
                    class="btn btn-secondary">

                    Kembali

                </a>

            </form>

        </div>

    </div>

</div>

</body>
</html>