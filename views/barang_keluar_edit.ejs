<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Edit Barang Keluar #<%= transaksi.id %></title>

    <link rel="icon" href="/drcom.png" type="image/png">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <style>
        body {
            background: #f4f6f9;
        }

        .thumb {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #dee2e6;
        }

        .item-card {
            border: 1px solid #dee2e6;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            background: #fff;
        }

        .form-label {
            font-weight: 600;
        }

        .status-info {
            font-size: 13px;
            color: #6c757d;
        }
    </style>
</head>

<body>

<div class="container py-4">

    <!-- Tombol kembali -->
    <a href="/" class="btn btn-outline-secondary btn-sm mb-3">
        &larr; Kembali
    </a>

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h5 class="mb-0">
                Edit Barang Keluar — Ref #<%= transaksi.id %>
            </h5>
        </div>

        <div class="card-body p-4">

            <form
                method="POST"
                action="/barang-keluar/edit/<%= transaksi.id %>"
                enctype="multipart/form-data"
            >

                <!-- Tujuan transaksi -->
                <div class="mb-4">
                    <label class="form-label">Tujuan</label>

                    <input
                        type="text"
                        name="tujuan"
                        class="form-control"
                        value="<%= transaksi.tujuan || '' %>"
                        required
                    >
                </div>

                <hr>

                <h6 class="fw-bold mb-3">Daftar Barang</h6>

                <% if (items && items.length > 0) { %>

                    <% items.forEach((it, idx) => { %>

                        <div class="item-card">

                            <input
                                type="hidden"
                                name="detail_id"
                                value="<%= it.detail_id %>"
                            >

                            <div class="row g-3">

                                <!-- Gambar -->
                                <div class="col-md-3 text-center">

                                    <% if (it.gambar) { %>

                                        <img
                                            src="/media/<%= it.gambar %>"
                                            class="thumb mb-2"
                                            alt="Gambar produk"
                                        >

                                    <% } else { %>

                                        <div
                                            class="border rounded mb-2 text-muted d-flex align-items-center justify-content-center mx-auto"
                                            style="width:100px;height:100px;"
                                        >
                                            No Image
                                        </div>

                                    <% } %>

                                    <label class="form-label small">
                                        Ganti Gambar
                                    </label>

                                    <input
                                        type="file"
                                        name="gambar_<%= it.detail_id %>"
                                        class="form-control form-control-sm"
                                        accept="image/*"
                                    >

                                    <small class="text-muted">
                                        Kosongkan jika tidak ingin mengganti gambar.
                                    </small>

                                </div>

                                <!-- Informasi barang -->
                                <div class="col-md-9">

                                    <div class="row g-3">

                                        <!-- Produk -->
                                        <div class="col-md-6">

                                            <label class="form-label">
                                                Produk
                                            </label>

                                            <select
                                                name="produk_id"
                                                class="form-select"
                                                required
                                            >

                                                <% produkList.forEach(p => { %>

                                                    <option
                                                        value="<%= p.id %>"
                                                        <%= Number(p.id) === Number(it.produk_id) ? 'selected' : '' %>
                                                    >
                                                        <%= p.nama %>
                                                    </option>

                                                <% }) %>

                                            </select>

                                        </div>

                                        <!-- Jumlah -->
                                        <div class="col-md-3">

                                            <label class="form-label">
                                                Jumlah
                                            </label>

                                            <input
                                                type="number"
                                                name="jumlah"
                                                min="1"
                                                class="form-control"
                                                value="<%= it.jumlah %>"
                                                required
                                            >

                                        </div>

                                        <!-- Ref ID -->
                                        <div class="col-md-3">

                                            <label class="form-label">
                                                Ref ID
                                            </label>

                                            <input
                                                type="text"
                                                class="form-control"
                                                value="<%= it.detail_id %>"
                                                readonly
                                            >

                                        </div>

                                        <!-- Keterangan -->
                                        <div class="col-12">

                                            <label class="form-label">
                                                Keterangan
                                            </label>

                                            <input
                                                type="text"
                                                name="keterangan"
                                                class="form-control"
                                                value="<%= it.keterangan || '' %>"
                                                placeholder="Masukkan keterangan barang"
                                            >

                                        </div>

                                        <!-- Status -->
                                        <div class="col-md-6">

                                            <label class="form-label">
                                                Status Barang
                                            </label>

                                            <select
                                                name="status"
                                                class="form-select"
                                                required
                                            >

                                                <option
                                                    value="2"
                                                    <%= Number(it.status) === 2 ? 'selected' : '' %>
                                                >
                                                    PROSES
                                                </option>

                                                <option
                                                    value="1"
                                                    <%= Number(it.status) === 1 ? 'selected' : '' %>
                                                >
                                                    SELESAI
                                                </option>

                                                <option
                                                    value="0"
                                                    <%= Number(it.status) === 0 ? 'selected' : '' %>
                                                >
                                                    CANCEL
                                                </option>

                                            </select>

                                            <div class="status-info mt-1">
                                                Pilih status terbaru untuk barang ini.
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <div class="alert alert-warning">
                        Tidak ada item barang dalam transaksi ini.
                    </div>

                <% } %>

                <!-- Tombol simpan -->
                <% if (items && items.length > 0) { %>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a href="/" class="btn btn-outline-secondary">
                            Batal
                        </a>

                        <button
                            type="submit"
                            class="btn btn-primary"
                            onclick="return confirm('Apakah Anda yakin ingin menyimpan perubahan barang keluar?')"
                        >
                            Simpan Perubahan
                        </button>

                    </div>

                <% } %>

            </form>

        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>