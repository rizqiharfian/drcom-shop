<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Barang Keluar Alex</title>

  <link rel="icon" href="/drcom.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">

  <style>
    body {
      background: #f8f9fa;
    }

    .container {
      max-width: 1100px;
    }

    th,
    td {
      vertical-align: middle;
    }

    .badge-pending {
      background: #dc3545;
    }

    .badge-masuk {
      background: #0d6efd;
    }

    .badge-beres {
      background: #198754;
    }

    .badge-cancel {
      background: #6c757d;
    }

    /* Pengaturan lebar tabel Barang Keluar Alex */
    .tabel-alex {
        width: 100%;
        table-layout: fixed;
    }

    /* Posisi teks dan jarak antar kolom */
    .tabel-alex th,
    .tabel-alex td {
        vertical-align: middle;
        padding: 12px;
    }

    /* Kolom Produk */
    .tabel-alex th:nth-child(3),
    .tabel-alex td:nth-child(3) {
        overflow-wrap: break-word;
        word-break: normal;
    }

    /* Kolom Harga */
    .tabel-alex th:nth-child(5),
    .tabel-alex td:nth-child(5) {
        white-space: nowrap;
    }

    /* Kolom Keterangan */
    .tabel-alex th:nth-child(6),
    .tabel-alex td:nth-child(6) {
        overflow-wrap: break-word;
    }

    /* Kolom Aksi */
    .tabel-alex th:nth-child(9),
    .tabel-alex td:nth-child(9) {
        text-align: center;
        white-space: normal;
    }

    /* Tampilan layar kecil */
    @media (max-width: 768px) {
        .tabel-alex {
            min-width: 1200px;
        }
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Manajemen Toko</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% const currentPath=typeof path !=='undefined' ? path : '/' ; %>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Beranda</a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/seller">Seller</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/claim-garansi' ? 'active' : '' %>"
                href="/claim-garansi">Claim Garansi</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-masuk' ? 'active' : '' %>"
                href="/barang-masuk">Barang Masuk</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar' ? 'active' : '' %>"
                href="/barang-keluar">Barang Keluar</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar-alex' ? 'active' : '' %>"
                href="/barang-keluar-alex">Barang Keluar Alex</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-hilang' ? 'active' : '' %>"
                href="/barang-hilang">Barang Hilang</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/produk' ? 'active' : '' %>"
                href="/produk">Produk</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/service-user' ? 'active' : '' %>"
                href="/service-user">Service User</a></li>
            <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button"
                data-bs-toggle="dropdown">Sparepart</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/sparepart">Master Sparepart</a></li>
                <!-- <li><a class="dropdown-item" href="/sparepart-masuk">Sparepart Masuk</a></li> -->
              </ul>
            </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container">

    <!-- FORM -->
    <div class="card shadow-sm mb-4">

      <div class="card-header bg-primary text-white">

        <h5 class="mb-0">
          Form Barang Keluar Alex
        </h5>

      </div>

      <div class="card-body">

        <form action="/barang-keluar-alex" method="POST">

          <div class="row g-3">

            <div class="col-md-4">
              <label class="form-label">
                Tujuan
              </label>

              <input type="text" name="tujuan" class="form-control" required>
            </div>

            <div class="col-md-4">

              <label class="form-label">
                Produk
              </label>

              <select name="produk_id" class="form-select produk-select">

                <option value="">
                  Pilih Produk
                </option>

                <% produk.forEach(p=> { %>

                  <option value="<%= p.id %>">
                    <%= p.nama %>
                  </option>

                  <% }) %>

              </select>

            </div>

            <div class="col-md-4">

              <label class="form-label">
                Produk Baru (Belum foto atau belum ada stok)
              </label>

              <input type="text" name="produk_baru" class="form-control">

            </div>

            <div class="col-md-2">

              <label class="form-label">
                Jumlah
              </label>

              <input type="number" name="jumlah" class="form-control" required>

            </div>

            <div class="col-md-3">

              <label class="form-label">
                Orderan
              </label>

              <input type="text" name="orderan" class="form-control">

            </div>

            <div class="col-md-3">

              <label class="form-label">
                Harga
              </label>

              <input type="text" name="harga" class="form-control">

            </div>

            <div class="col-md-10">

              <label class="form-label">
                Keterangan
              </label>

              <input type="text" name="keterangan" class="form-control">

            </div>

          </div>

          <div class="mt-3">

            <button class="btn btn-success" type="submit">

              Simpan Barang Alex

            </button>

          </div>

        </form>

      </div>

    </div>

    <!-- DATA -->
    <div class="card shadow-sm">

      <div class="card-header bg-dark text-white">

        <h5 class="mb-0">
          Data Barang Keluar Alex
        </h5>

      </div>

      <div class="card-body table-responsive">
        <!-- SEARCH BAR BARANG KELUAR ALEX -->
        <div class="row g-2 mb-3">
            <div class="col-md-8">
                <input
                    type="search"
                    id="searchBarangAlex"
                    class="form-control"
                    placeholder="Cari tujuan, produk, orderan, service, keterangan, status, tanggal..."
                >
            </div>

            <div class="col-md-2">
                <button
                    type="button"
                    class="btn btn-primary w-100"
                    id="btnSearchAlex">
                    <i class="bi bi-search"></i> Cari
                </button>
            </div>

            <div class="col-md-2">
                <button
                    type="button"
                    class="btn btn-secondary w-100"
                    id="btnResetAlex">
                    Reset
                </button>
            </div>
        </div>
        <!-- EXPORT PDF BARANG KELUAR ALEX -->
        <div class="d-flex justify-content-end mb-3">

            <button type="button"
                class="btn btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#modalExportAlex">

                <i class="bi bi-file-earmark-pdf"></i>
                Export PDF

            </button>

        </div>

        <!-- MODAL EXPORT -->
        <div class="modal fade" id="modalExportAlex" tabindex="-1">

            <div class="modal-dialog">

                <div class="modal-content">

                    <div class="modal-header bg-danger text-white">

                        <h5 class="modal-title">
                            Export PDF Barang Keluar Alex
                        </h5>

                        <button
                            type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                        </button>

                    </div>

                    <div class="modal-body">

                        <!-- SUPPLIER / TUJUAN -->
                        <div class="mb-3">

                            <label class="form-label">
                                Supplier / Tujuan
                            </label>

                            <select
                                id="supplierExportAlex"
                                class="form-select">

                                <option value="">
                                    Semua Supplier / Tujuan
                                </option>

                                <% if (typeof daftarTujuanAlex !== 'undefined' && daftarTujuanAlex) { %>

                                    <% daftarTujuanAlex.forEach(s => { %>

                                        <option value="<%= s.tujuan %>">
                                            <%= s.tujuan %>
                                        </option>

                                    <% }) %>

                                <% } %>

                            </select>

                        </div>

                        <!-- PERIODE -->
                        <div class="mb-3">

                            <label class="form-label">
                                Periode Export
                            </label>

                            <select
                                id="periodeExportAlex"
                                class="form-select">

                                <option value="semua">
                                    Semua Data
                                </option>

                                <option value="hari">
                                    Hari Ini
                                </option>

                                <option value="minggu">
                                    7 Hari Terakhir
                                </option>

                                <option value="bulan">
                                    Bulan Ini
                                </option>

                                <option value="custom">
                                    Tanggal Custom
                                </option>

                            </select>

                        </div>

                        <!-- CUSTOM DATE -->
                        <div id="customTanggalAlex" style="display:none">

                            <div class="mb-3">

                                <label class="form-label">
                                    Dari Tanggal
                                </label>

                                <input
                                    type="date"
                                    id="tglAwalAlex"
                                    class="form-control">

                            </div>

                            <div class="mb-3">

                                <label class="form-label">
                                    Sampai Tanggal
                                </label>

                                <input
                                    type="date"
                                    id="tglAkhirAlex"
                                    class="form-control">

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                            Tutup

                        </button>

                        <button
                            type="button"
                            class="btn btn-danger"
                            onclick="prosesExportAlex()">

                            <i class="bi bi-file-earmark-pdf"></i>
                            Export PDF

                        </button>

                    </div>

                </div>

            </div>

        </div>
        <div class="table-responsive">
        <table id="tabelBarangAlex" class="table table-bordered table-hover align-middle tabel-alex">

            <colgroup>
                <col style="width: 5%;">
                <col style="width: 10%;">
                <col style="width: 22%;">
                <col style="width: 9%;">
                <col style="width: 12%;">
                <col style="width: 14%;">
                <col style="width: 8%;">
                <col style="width: 9%;">
                <col style="width: 14%;">
            </colgroup>

          <thead class="table-dark text-center">
            <tr>
              <th>No</th>
              <th>Tujuan</th>
              <th>Produk</th>
              <th>Jumlah</th>
              <th>Harga</th>
              <th>Keterangan</th>
              <th>Status</th>
              <th>Tanggal</th>
              <th>Aksi</th>
            </tr>
          </thead>

          <tbody>

            <% data.forEach((d,index)=>{ %>

              <tr>

                <td>
                  <%= index+1 %>
                </td>
                <td>
                  <%= d.tujuan %>
                </td>
                <td>
                  <%= d.nama_produk %>
                </td>
                <td>
                  <%= d.jumlah %>
                </td>
                <!-- <td>
                  <%= d.orderan || '-' %>
                </td> -->
                <td>
                    Rp <%= Number(d.harga || 0).toLocaleString('id-ID') %>
                </td>
                <td>
                  <%= d.keterangan || '-' %>
                </td>
                <td>
                  <% if(d.status=='pending' ){ %>
                    <span class="badge badge-pending">
                      Pending
                    </span>

                    <% } %>

                      <% if(d.status=='masuk_stok' ){ %>

                        <span class="badge badge-masuk">
                          Masuk Stok
                        </span>

                        <% } %>

                          <% if(d.status=='beres' ){ %>

                            <span class="badge badge-beres">
                              Beres
                            </span>

                            <% } %>

                              <% if(d.status=='cancel' ){ %>

                                <span class="badge badge-cancel">
                                  Cancel
                                </span>

                                <% } %>

                </td>

                <td>
                  <%= new Date(d.created_at).toLocaleString('id-ID') %>
                </td>

                <td class="text-center">

                  <a
                      href="/barang-keluar-alex/<%= d.id %>/edit"
                      class="btn btn-warning btn-sm mb-1">
                      <i class="bi bi-pencil-square"></i> Edit
                  </a>

                  <% if(d.status=='pending' ){ %>

                    <form action="/barang-keluar-alex/<%= d.id %>/masuk-stok" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-primary btn-sm">
                        Masuk Stok
                      </button>
                    </form>

                    <form action="/barang-keluar-alex/<%= d.id %>/beres" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-success btn-sm">
                        Beres
                      </button>
                    </form>

                    <form action="/barang-keluar-alex/<%= d.id %>/cancel" method="POST" style="display:inline;"
                      onsubmit="return confirm('Yakin ingin membatalkan data ini?');">
                      <button type="submit" class="btn btn-secondary btn-sm">
                        Cancel
                      </button>
                    </form>
                    <% } else { %>
                      <% if(d.status=='masuk_stok' ){ %> <span class="text-primary fw-bold">Masuk Stok</span>
                        <% } %>

                          <% if(d.status=='beres' ){ %><span class="text-success fw-bold">Beres</span>
                            <% } %>

                              <% if(d.status=='cancel' ){ %><span class="text-secondary fw-bold">Cancel</span>
                                <% } %>
                                  <% } %>
                </td>

              </tr>

              <% }) %>

          </tbody>
          
        </table>
        <div class="d-flex justify-content-between align-items-center mt-3">
          <small id="infoPagination" class="text-muted"></small>

          <nav>
            <ul id="paginationAlex" class="pagination pagination-sm mb-0"></ul>
          </nav>
        </div>
        
      </div>

    </div>

  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <script>
    $(document).ready(function () {

      $('.produk-select').select2({
        placeholder: 'Cari Produk...',
        allowClear: true,
        width: '100%'
      });

    });
  </script>
  <script>

    // ======================================================
    // EXPORT PDF BARANG KELUAR ALEX
    // ======================================================

    document.getElementById('periodeExportAlex')
        .addEventListener('change', function() {

            const custom = document.getElementById('customTanggalAlex');

            if (this.value === 'custom') {
                custom.style.display = 'block';
            } else {
                custom.style.display = 'none';
            }

        });


    // ======================================================
    // PROSES EXPORT
    // ======================================================

    function prosesExportAlex() {

        const supplier = document.getElementById('supplierExportAlex').value;
        const periode = document.getElementById('periodeExportAlex').value;

        let url = '/export/barang-keluar-alex';

        const params = new URLSearchParams();

        // Filter supplier
        if (supplier) {
            params.set('supplier', supplier);
        }

        // Semua data
        if (periode === 'semua') {

            // Tidak perlu filter tanggal

        }

        // Hari ini
        else if (periode === 'hari') {

            const today = new Date();

            const tanggal = formatDateAlex(today);

            params.set('start', tanggal);
            params.set('end', tanggal);

        }

        // 7 hari terakhir
        else if (periode === 'minggu') {

            const today = new Date();
            const first = new Date();

            first.setDate(today.getDate() - 6);

            params.set('start', formatDateAlex(first));
            params.set('end', formatDateAlex(today));

        }

        // Bulan ini
        else if (periode === 'bulan') {

            const today = new Date();

            const first = new Date(
                today.getFullYear(),
                today.getMonth(),
                1
            );

            params.set('start', formatDateAlex(first));
            params.set('end', formatDateAlex(today));

        }

        // Custom
        else if (periode === 'custom') {

            const start = document.getElementById('tglAwalAlex').value;
            const end = document.getElementById('tglAkhirAlex').value;

            if (!start || !end) {
                alert('Silakan pilih tanggal awal dan akhir.');
                return;
            }

            if (start > end) {
                alert('Tanggal awal tidak boleh melebihi tanggal akhir.');
                return;
            }

            params.set('start', start);
            params.set('end', end);

        }

        const query = params.toString();

        if (query) {
            url += '?' + query;
        }

        window.open(url, '_blank');

    }


    // ======================================================
    // FORMAT TANGGAL
    // ======================================================

    function formatDateAlex(date) {

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');

        return `${year}-${month}-${day}`;

    }

    // ==========================================
    // PAGINATION BARANG KELUAR ALEX
    // 10 DATA PER HALAMAN
    // ==========================================

    document.addEventListener('DOMContentLoaded', function () {

        const table = document.getElementById('tabelBarangAlex');
        const searchInput = document.getElementById('searchBarangAlex');
        const searchButton = document.getElementById('btnSearchAlex');
        const resetButton = document.getElementById('btnResetAlex');
        const pagination = document.getElementById('paginationAlex');
        const info = document.getElementById('infoPagination');

        if (!table || !searchInput || !searchButton ||
            !resetButton || !pagination || !info) {
            console.error('Elemen pencarian atau pagination tidak ditemukan.');
            return;
        }

        const tbody = table.querySelector('tbody');
        const allRows = Array.from(tbody.querySelectorAll('tr'));

        const perPage = 10;
        let currentPage = 1;
        let filteredRows = [...allRows];

        function filterData() {
            const keyword = searchInput.value.trim().toLowerCase();

            filteredRows = allRows.filter(row => {
                // Kolom 0 = No, kolom 9 = Aksi.
                // Pencarian dilakukan pada kolom Tujuan sampai Tanggal.
                const searchableText = Array.from(row.cells)
                    .slice(1, 9)
                    .map(cell => cell.innerText)
                    .join(' ')
                    .toLowerCase();

                return searchableText.includes(keyword);
            });

            currentPage = 1;
            showPage();
        }

        function showPage() {
            const totalData = filteredRows.length;
            const totalPages = Math.ceil(totalData / perPage);
            const safeTotalPages = Math.max(totalPages, 1);

            if (currentPage > safeTotalPages) {
                currentPage = safeTotalPages;
            }

            // Sembunyikan semua baris terlebih dahulu
            allRows.forEach(row => {
                row.style.display = 'none';
            });

            // Tampilkan data sesuai halaman
            const start = (currentPage - 1) * perPage;
            const end = start + perPage;
            const pageRows = filteredRows.slice(start, end);

            pageRows.forEach((row, index) => {
                row.style.display = '';
                row.cells[0].innerText = start + index + 1;
            });

            // Informasi jumlah data
            if (totalData === 0) {
                info.innerText = 'Tidak ada data yang ditemukan.';
            } else {
                info.innerText =
                    `Menampilkan ${start + 1} - ${Math.min(end, totalData)} dari ${totalData} data`;
            }

            // Buat tombol pagination
            pagination.innerHTML = '';

            if (totalPages <= 1) return;

            function createButton(label, page, disabled, active = false) {
                const li = document.createElement('li');
                li.className = 'page-item';

                if (disabled) li.classList.add('disabled');
                if (active) li.classList.add('active');

                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'page-link';
                button.innerText = label;

                button.addEventListener('click', function () {
                    if (disabled) return;

                    currentPage = page;
                    showPage();
                });

                li.appendChild(button);
                pagination.appendChild(li);
            }

            createButton('«', currentPage - 1, currentPage === 1);

            for (let i = 1; i <= totalPages; i++) {
                createButton(i, i, false, currentPage === i);
            }

            createButton('»', currentPage + 1, currentPage === totalPages);
        }

        // Tombol Cari
        searchButton.addEventListener('click', filterData);

        // Bisa tekan Enter untuk mencari
        searchInput.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                filterData();
            }
        });

        // Tombol Reset
        resetButton.addEventListener('click', function () {
            searchInput.value = '';
            filteredRows = [...allRows];
            currentPage = 1;
            showPage();
        });

        // Tampilan awal
        showPage();

    });

  </script>
</body>

</html>