<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Barang Keluar Alex</title>

  <link rel="icon" href="/drcom.png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">

  <style>
    body {
      background: #f8f9fa;
    }

    .container {
      max-width: 1100px;
    }

    th,
    td {
      vertical-align: middle;
    }

    .badge-pending {
      background: #dc3545;
    }

    .badge-masuk {
      background: #0d6efd;
    }

    .badge-beres {
      background: #198754;
    }

    .badge-cancel {
      background: #6c757d;
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Manajemen Toko</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% const currentPath=typeof path !=='undefined' ? path : '/' ; %>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Beranda</a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/seller">Seller</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/claim-garansi' ? 'active' : '' %>"
                href="/claim-garansi">Claim Garansi</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-masuk' ? 'active' : '' %>"
                href="/barang-masuk">Barang Masuk</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar' ? 'active' : '' %>"
                href="/barang-keluar">Barang Keluar</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar-alex' ? 'active' : '' %>"
                href="/barang-keluar-alex">Barang Keluar Alex</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-hilang' ? 'active' : '' %>"
                href="/barang-hilang">Barang Hilang</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/produk' ? 'active' : '' %>"
                href="/produk">Produk</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/service-user' ? 'active' : '' %>"
                href="/service-user">Service User</a></li>
            <li class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="#" role="button"
                data-bs-toggle="dropdown">Sparepart</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/sparepart">Master Sparepart</a></li>
                <!-- <li><a class="dropdown-item" href="/sparepart-masuk">Sparepart Masuk</a></li> -->
              </ul>
            </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container">

    <!-- FORM -->
    <div class="card shadow-sm mb-4">

      <div class="card-header bg-primary text-white">

        <h5 class="mb-0">
          Form Barang Keluar Alex
        </h5>

      </div>

      <div class="card-body">

        <form action="/barang-keluar-alex" method="POST">

          <div class="row g-3">

            <div class="col-md-4">
              <label class="form-label">
                Tujuan
              </label>

              <input type="text" name="tujuan" class="form-control" required>
            </div>

            <div class="col-md-4">

              <label class="form-label">
                Produk
              </label>

              <select name="produk_id" class="form-select produk-select">

                <option value="">
                  Pilih Produk
                </option>

                <% produk.forEach(p=> { %>

                  <option value="<%= p.id %>">
                    <%= p.nama %>
                  </option>

                  <% }) %>

              </select>

            </div>

            <div class="col-md-4">

              <label class="form-label">
                Produk Baru (Belum foto atau belum ada stok)
              </label>

              <input type="text" name="produk_baru" class="form-control">

            </div>

            <div class="col-md-2">

              <label class="form-label">
                Jumlah
              </label>

              <input type="number" name="jumlah" class="form-control" required>

            </div>

            <div class="col-md-3">

              <label class="form-label">
                Orderan
              </label>

              <input type="text" name="orderan" class="form-control">

            </div>

            <div class="col-md-3">

              <label class="form-label">
                Service
              </label>

              <input type="text" name="service" class="form-control">

            </div>

            <div class="col-md-10">

              <label class="form-label">
                Keterangan
              </label>

              <input type="text" name="keterangan" class="form-control">

            </div>

          </div>

          <div class="mt-3">

            <button class="btn btn-success" type="submit">

              Simpan Barang Alex

            </button>

          </div>

        </form>

      </div>

    </div>

    <!-- DATA -->
    <div class="card shadow-sm">

      <div class="card-header bg-dark text-white">

        <h5 class="mb-0">
          Data Barang Keluar Alex
        </h5>

      </div>

      <div class="card-body table-responsive">
        <div class="d-flex justify-content-end mb-3">
          <div class="btn-group">
            <button class="btn btn-danger dropdown-toggle" data-bs-toggle="dropdown">Export PDF</button>

            <ul class="dropdown-menu dropdown-menu-end">

              <li><a class="dropdown-item" href="/export/barang-keluar-alex">Semua Data</a></li>
              <li><a class="dropdown-item" onclick="exportHari()" href="#">Hari Ini</a></li>
              <li><a class="dropdown-item" onclick="exportMinggu()" href="#">Minggu Ini</a></li>
              <li><a class="dropdown-item" onclick="exportBulan()" href="#">Bulan Ini</a></li>
              <li>
                <hr class="dropdown-divider">
              </li>

              <li class="px-3">
                <label>Dari</label>
                <input type="date" id="tglAwal" class="form-control form-control-sm mb-2">
                <label>Sampai</label>
                <input type="date" id="tglAkhir" class="form-control form-control-sm mb-2">
                <button type="button" class="btn btn-primary btn-sm w-100" onclick="exportCustom()">Export</button>
              </li>
            </ul>
          </div>
        </div>
        <table class="table table-bordered table-hover align-middle">

          <thead class="table-dark text-center">

            <tr>
              <th>No</th>
              <th width="10">Tujuan</th>
              <th>Produk</th>
              <th>Jumlah</th>
              <th>Orderan</th>
              <th>Service</th>
              <th>Keterangan</th>
              <th>Status</th>
              <th>Tanggal</th>
              <th width="280">
                Aksi
              </th>
            </tr>

          </thead>

          <tbody>

            <% data.forEach((d,index)=>{ %>

              <tr>

                <td>
                  <%= index+1 %>
                </td>
                <td>
                  <%= d.tujuan %>
                </td>
                <td>
                  <%= d.nama_produk %>
                </td>
                <td>
                  <%= d.jumlah %>
                </td>
                <td>
                  <%= d.orderan || '-' %>
                </td>
                <td>
                  <%= d.service || '-' %>
                </td>
                <td>
                  <%= d.keterangan || '-' %>
                </td>
                <td>
                  <% if(d.status=='pending' ){ %>
                    <span class="badge badge-pending">
                      Pending
                    </span>

                    <% } %>

                      <% if(d.status=='masuk_stok' ){ %>

                        <span class="badge badge-masuk">
                          Masuk Stok
                        </span>

                        <% } %>

                          <% if(d.status=='beres' ){ %>

                            <span class="badge badge-beres">
                              Beres
                            </span>

                            <% } %>

                              <% if(d.status=='cancel' ){ %>

                                <span class="badge badge-cancel">
                                  Cancel
                                </span>

                                <% } %>

                </td>

                <td>
                  <%= new Date(d.created_at).toLocaleString('id-ID') %>
                </td>

                <td class="text-center">

                  <% if(d.status=='pending' ){ %>

                    <form action="/barang-keluar-alex/<%= d.id %>/masuk-stok" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-primary btn-sm">
                        Masuk Stok
                      </button>
                    </form>

                    <form action="/barang-keluar-alex/<%= d.id %>/beres" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-success btn-sm">
                        Beres
                      </button>
                    </form>

                    <form action="/barang-keluar-alex/<%= d.id %>/cancel" method="POST" style="display:inline;"
                      onsubmit="return confirm('Yakin ingin membatalkan data ini?');">
                      <button type="submit" class="btn btn-secondary btn-sm">
                        Cancel
                      </button>
                    </form>
                    <% } else { %>
                      <% if(d.status=='masuk_stok' ){ %> <span class="text-primary fw-bold">Masuk Stok</span>
                        <% } %>

                          <% if(d.status=='beres' ){ %><span class="text-success fw-bold">Beres</span>
                            <% } %>

                              <% if(d.status=='cancel' ){ %><span class="text-secondary fw-bold">Cancel</span>
                                <% } %>
                                  <% } %>
                </td>

              </tr>

              <% }) %>

          </tbody>
          <div class="d-flex justify-content-between align-items-center mt-3">
            <small id="infoPagination" class="text-muted"></small>

            <nav>
              <ul id="paginationAlex" class="pagination pagination-sm mb-0"></ul>
            </nav>
          </div>

        </table>

      </div>

    </div>

  </div>

  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

  <script>
    $(document).ready(function () {

      $('.produk-select').select2({
        placeholder: 'Cari Produk...',
        allowClear: true,
        width: '100%'
      });

    });
  </script>
  <script>

    function formatDate(date) {

      return date
        .toISOString()
        .split('T')[0];

    }

    // =====================
    // HARI INI
    // =====================

    function exportHari() {

      const today = formatDate(
        new Date()
      );

      window.open(
        `/export/barang-keluar-alex?start=${today}&end=${today}`,
        '_blank'
      );

    }

    // =====================
    // MINGGU INI
    // =====================

    function exportMinggu() {

      const today = new Date();

      const first = new Date();

      first.setDate(
        today.getDate() - 7
      );

      window.open(
        `/export/barang-keluar-alex?start=${formatDate(first)}&end=${formatDate(today)}`,
        '_blank'
      );

    }

    // =====================
    // BULAN INI
    // =====================

    function exportBulan() {

      const today = new Date();

      const first = new Date(
        today.getFullYear(),
        today.getMonth(),
        1
      );

      window.open(
        `/export/barang-keluar-alex?start=${formatDate(first)}&end=${formatDate(today)}`,
        '_blank'
      );

    }

    // =====================
    // CUSTOM
    // =====================

    function exportCustom() {
      const start =
        document.getElementById('tglAwal').value;

      const end =
        document.getElementById('tglAkhir').value;

      if (!start || !end) {
        alert('Pilih tanggal terlebih dahulu');
        return;
      }
      window.open(
        `/export/barang-keluar-alex?start=${start}&end=${end}`,
        '_blank'
      );
    }

    // ==========================================
    // PAGINATION BARANG KELUAR ALEX
    // 10 DATA PER HALAMAN
    // ==========================================

    document.addEventListener('DOMContentLoaded', function () {

      const table = document.querySelector('.table-bordered');
      const tbody = table.querySelector('tbody');
      const pagination = document.getElementById('paginationAlex');
      const info = document.getElementById('infoPagination');

      const rows = Array.from(tbody.querySelectorAll('tr'));

      const perPage = 10;
      let currentPage = 1;

      const totalData = rows.length;
      const totalPages = Math.ceil(totalData / perPage);

      function renderPagination() {

        const start = (currentPage - 1) * perPage;
        const end = start + perPage;

        // Tampilkan hanya 10 data sesuai halaman
        rows.forEach((row, index) => {
          row.style.display =
            index >= start && index < end ? '' : 'none';

          // Nomor urut mengikuti halaman
          row.cells[0].textContent = index + 1;
        });

        // Informasi jumlah data
        if (totalData === 0) {
          info.textContent = 'Tidak ada data';
        } else {
          info.textContent =
            `Menampilkan ${start + 1}–${Math.min(end, totalData)} dari ${totalData} data`;
        }

        // Tombol pagination
        pagination.innerHTML = '';

        if (totalPages <= 1) return;

        // Tombol sebelumnya
        pagination.innerHTML += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <button class="page-link" data-page="${currentPage - 1}">
                    Sebelumnya
                </button>
            </li>
        `;

        // Nomor halaman
        for (let i = 1; i <= totalPages; i++) {
          pagination.innerHTML += `
                <li class="page-item ${currentPage === i ? 'active' : ''}">
                    <button class="page-link" data-page="${i}">
                        ${i}
                    </button>
                </li>
            `;
        }

        // Tombol berikutnya
        pagination.innerHTML += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <button class="page-link" data-page="${currentPage + 1}">
                    Berikutnya
                </button>
            </li>
        `;
      }

      // Klik tombol pagination
      pagination.addEventListener('click', function (e) {

        const button = e.target.closest('button[data-page]');

        if (!button) return;

        const page = Number(button.dataset.page);

        if (page < 1 || page > totalPages) return;

        currentPage = page;
        renderPagination();
      });

      renderPagination();

    });

  </script>
</body>

</html>