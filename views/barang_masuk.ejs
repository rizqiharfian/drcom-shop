<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Barang Masuk</title>
  <link rel="icon" href="/drcom.png" type="image/png">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

  <!-- SELECT2 -->
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

  <!-- JQUERY (WAJIB sebelum select2) -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <!-- SELECT2 JS -->
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
</head>

<body class="bg-light">

<!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">Manajemen Toko</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ms-auto">
          <% const currentPath=typeof path !=='undefined' ? path : '/' ; %>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Beranda</a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/seller">Seller</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/claim-garansi' ? 'active' : '' %>"
                href="/claim-garansi">Claim Garansi</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-masuk' ? 'active' : '' %>"
                href="/barang-masuk">Barang Masuk</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar' ? 'active' : '' %>"
                href="/barang-keluar">Barang Keluar</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-keluar-alex' ? 'active' : '' %>"
                href="/barang-keluar-alex">Barang Keluar Alex</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/barang-hilang' ? 'active' : '' %>"
                href="/barang-hilang">Barang Hilang</a></li>
            <li class="nav-item"><a class="nav-link <%= currentPath === '/produk' ? 'active' : '' %>"
                href="/produk">Produk</a></li>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Sparepart</a>
              <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="/sparepart">Master Sparepart</a></li>
                <!-- <li><a class="dropdown-item" href="/sparepart-masuk">Sparepart Masuk</a></li> -->
              </ul>
            </li>
        </ul>
      </div>
    </div>
  </nav>

<div class="container mt-5">
  <h2 class="text-center mb-4">Form Barang Masuk</h2>

  <form action="/barang-masuk" method="POST" id="formMasuk" enctype="multipart/form-data">

    <!-- Pengirim -->
    <div class="mb-3">
      <label class="form-label">Nama Pengirim</label>
      <input type="text" class="form-control" name="pengirim" id="pengirim" required />
    </div>

    <div class="mb-3">
      <label class="form-label">Nama Penerima</label>
      <input type="text" class="form-control" name="penerima" id="penerima" required />
    </div>

    <div class="mb-3">
      <label class="form-label">Cabang Tujuan</label>

      <select class="form-select" name="cabang_id" required>
          <option value="">-- Pilih Cabang --</option>
          <option value="1">Jakarta</option>
          <option value="2">Semarang</option>
      </select>
  </div>

    <!-- TABLE -->
    <table class="table table-bordered text-center">
      <thead class="table-primary">
        <tr>
          <th>Produk</th>
          <th>Nama Baru</th>
          <th>Jumlah</th>
          <th>Harga</th>
          <th>Keterangan</th>
          <th>Gambar</th>
          <th>Aksi</th>
        </tr>
      </thead>

      <tbody id="itemsContainer">
        <tr class="item-row">
          <td>
            <select name="produk[]" class="form-select produk-select" required>
              <option value="">-- Pilih Produk --</option>
              <% produk.forEach(p => { %>
                <option value="<%= p.id %>"><%= p.nama %></option>
              <% }) %>
              <option value="__TAMBAH_BARU__">+ Tambah Baru</option>
            </select>
          </td>

          <td>
            <input type="text" name="produk_nama[]" class="form-control produk-nama" style="display:none;">
          </td>

          <td>
            <input type="number" name="jumlah[]" class="form-control jumlah" min="1" required>
          </td>

          <td>
              <input type="number" name="harga[]" class="form-control harga" min="0" placeholder="Harga">
          </td>

          <td>
            <input type="text" name="keterangan[]" class="form-control">
          </td>

          <td>
            <input type="file" name="gambar" accept="image/*" class="form-control">
          </td>

          <td>
            <button type="button" class="btn btn-danger btn-sm removeRow">Hapus</button>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="text-center">
      <button type="button" id="addRow" class="btn btn-success mb-3">+ Tambah Produk</button><br>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </div>

  </form>
</div>

<script>
/* =========================
   INIT SELECT2
========================= */
function initSelect2() {
  $('.produk-select').select2({
    placeholder: '-- Cari Produk (contoh: laptop asus) --',
    allowClear: true,
    width: '100%'
  });
}

$(document).ready(function () {
  initSelect2();
});


/* =========================
   TAMBAH ROW
========================= */
$('#addRow').click(function () {

    let clone = $('.item-row:first').clone();

    // destroy select2 lama
    clone.find('.produk-select').select2('destroy');

    clone.find('input').val('');
    clone.find('select').val('');

    clone.find('.produk-nama')
        .hide()
        .prop('required', false);

    $('#itemsContainer').append(clone);

    initSelect2();
});


/* =========================
   HAPUS ROW
========================= */
$(document).on('click', '.removeRow', function () {
  if ($('.item-row').length > 1) {
    $(this).closest('tr').remove();
  }
});


/* =========================
   TOGGLE TAMBAH BARU
========================= */
$(document).on('change','.produk-select',function(){

    let tr=$(this).closest('tr');

    if($(this).val()=="__TAMBAH_BARU__"){

        tr.find('.produk-nama')
          .show()
          .prop('required',true);

    }else{

        tr.find('.produk-nama')
          .hide()
          .val('')
          .prop('required',false);

    }

});

$(document).on('change','.produk-select',function(){

    if($(this).val()=="__TAMBAH_BARU__"){

        $(this)
            .closest('tr')
            .find('.produk-nama')
            .focus();

    }

});


/* =========================
   VALIDASI
========================= */
$('#formMasuk').submit(function(e){

    if($('#pengirim').val().trim()==""){

        e.preventDefault();
        alert("Nama pengirim wajib diisi");
        return;

    }

    if($('#penerima').val().trim()==""){

        e.preventDefault();
        alert("Nama penerima wajib diisi");
        return;

    }


    if($('[name="cabang_id"]').val()==""){

        e.preventDefault();
        alert("Pilih cabang tujuan.");
        return;

    }

    let valid=false;

    $('.item-row').each(function(){

        const produk=$(this).find('.produk-select').val();
        const baru=$(this).find('.produk-nama').val().trim();
        const qty=parseInt($(this).find('.jumlah').val())||0;
        const harga=parseFloat($(this).find('.harga').val())||0;

        if(produk=="__TAMBAH_BARU__"){

            if(baru!="" && qty>0 && harga>0)
                valid=true;

        }else{

            if(produk!="" && qty>0 && harga>0)
                valid=true;

        }

    });

    if(!valid){

        e.preventDefault();
        alert("Minimal satu produk harus diisi.");

    }

});
</script>

</body>
</html>