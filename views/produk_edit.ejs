<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Edit Produk: <%= p.nama %></title>
  <link rel="icon" href="/drcom.png" type="image/png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <div class="container mt-4">
    <a class="btn btn-sm btn-outline-secondary mb-3" href="/produk/<%= p.id %>">← Kembali</a>

    <div class="card">
      <div class="card-body">
        <form action="/produk/<%= p.id %>" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label">Nama</label>
            <input type="text" name="nama" class="form-control" value="<%= p.nama %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label">Kode Produk</label>
            <input 
              type="text" 
              name="kode_produk" 
              class="form-control"
              value="<%= p.kode_produk || '' %>"
              required>
          </div>

          <div class="mb-3">
            <label class="form-label">Merk (Brand)</label>
            <select name="brand_id" class="form-select">
              <option value="">-- Pilih Merk (opsional) --</option>
              <% (brands||[]).forEach(b => { %>
                <option value="<%= b.id %>" <%= (p.brand_id == b.id) ? 'selected' : '' %>><%= b.name %></option>
              <% }) %>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Gambar (upload tambahan)</label>
            <input type="file" name="gambar" class="form-control" accept="image/*" multiple>
            <div class="mt-2 d-flex flex-wrap gap-2">
  <% p.gambar_list.forEach(fn => { %>
    <div class="position-relative" style="width:80px;height:80px;">

      <img 
        src="/media/<%= fn %>" 
        style="width:80px;height:80px;object-fit:cover;border-radius:6px;border:1px solid #ddd;"
      >

      <!-- tombol hapus -->
      <a 
        href="/produk/<%= p.id %>/hapus-gambar/<%= fn %>"
        onclick="return confirm('Hapus gambar ini?')"
        class="btn btn-danger btn-sm rounded-circle d-flex align-items-center justify-content-center"
        style="
          position:absolute;
          top:-8px;
          right:-8px;
          width:24px;
          height:24px;
          padding:0;
          font-size:14px;
          line-height:1;
          text-decoration:none;
        "
      >
        ×
      </a>

    </div>
  <% }) %>
</div>
            <div class="form-text">Upload gambar baru akan ditambahkan ke yang sudah ada.</div>
          </div>

          <div class="row">

            <div class="col-md-6">
              <label class="form-label">
                Harga Modal
              </label>

              <input
                type="number"
                name="harga_modal"
                class="form-control"
                value="<%= p.harga_modal || 0 %>">
            </div>

            <div class="col-md-6">
              <label class="form-label">
                Harga Jual
              </label>

              <input
                type="number"
                name="harga_jual"
                class="form-control"
                value="<%= p.harga_jual || 0 %>">
            </div>

          </div>

          <div class="mb-3">
            <label class="form-label">Keterangan</label>
            <textarea name="keterangan" class="form-control" rows="3"><%= p.keterangan || '' %></textarea>
          </div>

          <div class="row">

            <!-- STOK JAKARTA -->
            <div class="col-md-6">

              <div class="card border-primary mb-3">

                <div class="card-header bg-primary text-white">
                  Stok Jakarta
                </div>

                <div class="card-body">

                  <label class="form-label">
                    Jumlah Stok
                  </label>

                  <input
                    type="number"
                    name="stok_jakarta"
                    class="form-control"
                    min="0"
                    value="<%= stok_jakarta %>">

                </div>

              </div>

            </div>

            <!-- STOK SEMARANG -->
            <div class="col-md-6">

              <div class="card border-warning mb-3">

                <div class="card-header bg-warning">
                  Stok Semarang
                </div>

                <div class="card-body">

                  <label class="form-label">
                    Jumlah Stok
                  </label>

                  <input
                    type="number"
                    name="stok_semarang"
                    class="form-control"
                    min="0"
                    value="<%= stok_semarang %>">

                </div>

              </div>

            </div>

          </div>

          <div class="mb-3">
            <label class="form-label">Posisi (lokasi unit)</label>
            <input type="text" name="posisi" class="form-control" value="<%= p.posisi || '' %>">
          </div>

          <button class="btn btn-primary" type="submit">Simpan Perubahan</button>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
