<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">

    <title>History Tukar Unit</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>

<body>

    <div class="container mt-4">

        <h2>

            History Tukar Unit

        </h2>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>Tanggal</th>

                    <th>Seller</th>

                    <th>Toko</th>

                    <th>Produk Lama</th>

                    <th>Produk Baru</th>

                    <th>Jumlah</th>

                    <th>Alasan</th>

                    <th>Foto</th>

                </tr>

            </thead>

            <tbody>

                <% history.forEach(h=>{ %>

                    <tr>

                        <td>

                            <%= new Date(h.created_at).toLocaleString("id-ID") %>

                        </td>

                        <td>

                            <%= h.nama_seller %>

                        </td>

                        <td>

                            <%= h.nama_toko %>

                        </td>

                        <td>

                            <%= h.produk_lama %>

                        </td>

                        <td>

                            <%= h.produk_baru %>

                        </td>

                        <td>

                            <%= h.jumlah %>

                        </td>

                        <td>

                            <%= h.alasan %>

                        </td>

                        <td>

                            <% if(h.gambar){ %>

                                <img src="/uploads/<%= h.gambar %>" width="80">

                                <% } %>

                        </td>

                    </tr>

                    <% }) %>

            </tbody>

        </table>

        <a href="/" class="btn btn-secondary">

            Kembali

        </a>

    </div>

</body>

</html>