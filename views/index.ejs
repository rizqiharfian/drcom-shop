  </script>
  <script>
    // helper: format date yyyy-mm-dd
    function toYMD(d) {
      const pad = n => (n < 10 ? '0' + n : '' + n);
      return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    }

    // compute week start (Monday) and end (Sunday)
    function weekRange(d) {
      const date = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      const day = (date.getDay() + 6) % 7; // Monday = 0
      const monday = new Date(date);
      monday.setDate(date.getDate() - day);
      const sunday = new Date(monday);
      sunday.setDate(monday.getDate() + 6);
      return { start: toYMD(monday), end: toYMD(sunday) };
    }

    // open export url in new tab. route: /export/all/pdf?start=YYYY-MM-DD&end=YYYY-MM-DD
    function openExportAll(start, end) {
      if (!start || !end) return alert('Range belum lengkap.');
      const url = `/export/all/pdf?start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}`;
      window.open(url, '_blank');
    }

    // attach listeners (works with or without jQuery)
    (function () {
      const el = id => document.getElementById(id);

      // today
      el('exportAll_today').addEventListener('click', function (e) {
        e.preventDefault();
        const today = toYMD(new Date());
        openExportAll(today, today);
      });

      // week
      el('exportAll_week').addEventListener('click', function (e) {
        e.preventDefault();
        const r = weekRange(new Date());
        openExportAll(r.start, r.end);
      });

      // month
      el('exportAll_month').addEventListener('click', function (e) {
        e.preventDefault();
        const now = new Date();
        const start = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-01';
        const endDate = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
        const end = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(endDate).padStart(2, '0');
        openExportAll(start, end);
      });

      // custom
      el('exportAll_custom').addEventListener('click', function (e) {
        e.preventDefault();
        const s = el('exportAll_start').value;
        const eD = el('exportAll_end').value;
        if (!s || !eD) return alert('Pilih tanggal mulai dan akhir.');
        if (s > eD) return alert('Tanggal mulai harus <= tanggal akhir.');
        openExportAll(s, eD);
      });
    })();
  </script>
  <script>
    $('#seller_id').on('change', function () {

      const sellerId = $(this).val();

      $('#toko_id option').hide();

      $('#toko_id option:first').show();

      $('#toko_id option[data-seller="' + sellerId + '"]').show();

      $('#toko_id').val('');

    });
  </script>
  <script>

    document.addEventListener('DOMContentLoaded', () => {

      const sellerSelect =
        document.getElementById('seller_id');

      const tokoSelect =
        document.getElementById('toko_id');

      sellerSelect.addEventListener(
        'change',
        async function () {

          const sellerId = this.value;

          tokoSelect.innerHTML =
            '<option>Loading...</option>';

          if (!sellerId) {

            tokoSelect.innerHTML =
              '<option value="">Pilih Seller Dahulu</option>';

            return;
          }

          try {

            const response =
              await fetch(`/seller/${sellerId}/toko`);

            const data =
              await response.json();

            let html =
              '<option value="">Pilih Toko</option>';

            data.forEach(t => {

              html += `
            <option value="${t.id}">
              ${t.nama_toko}
            </option>
          `;

            });

            tokoSelect.innerHTML = html;

          } catch (err) {

            console.error(err);

            tokoSelect.innerHTML =
              '<option value="">Gagal memuat toko</option>';

          }

        }
      );

    });

  </script>

</body>

</html>