<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Stok Jakarta</title>

  <link rel="icon" href="/drcom.png" type="image/png">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>

    .search-card {
      width: 350px;
    }

    .table td,
    .table th {
      vertical-align: middle;
    }

  </style>

</head>

<body class="bg-light">

<div class="container py-4">

  <!-- HEADER -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <h2 class="mb-0">
      Stok Cabang Jakarta
    </h2>

    <!-- SEARCH -->
    <div class="card shadow-sm search-card">

      <div class="card-body p-2">

        <input
          type="text"
          id="searchInput"
          class="form-control"
          placeholder="Cari nama / kode / posisi...">

      </div>

    </div>

    <!-- BUTTON -->
    <div>

      <a
        href="/stok/semarang"
        class="btn btn-primary me-2">

        Cabang Semarang

      </a>

      <a
        href="/produk"
        class="btn btn-warning me-2">

        Semua Stok Pusat

      </a>

      <a
        href="/"
        class="btn btn-secondary">

        Kembali

      </a>

    </div>

  </div>

  <!-- TABLE -->
  <div class="card shadow-sm">

    <div class="card-body table-responsive">

      <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark text-center">

          <tr>

            <th width="70">
              No
            </th>

            <th width="90">
              Kode
            </th>

            <th>
              Produk
            </th>

            <th width="160">
              Posisi
            </th>

            <th width="120">
              Stok Jakarta
            </th>

            <th width="120">
              Stok Jakarta
            </th>

            <th width="100">
              Terkirim
            </th>

            <th width="100">
              Sisa
            </th>

            <th width="130">
              Status
            </th>

            <th width="120">
              Aksi
            </th>

          </tr>

        </thead>

        <tbody>

<%
let activeIndex = 1;
%>

<% produk.forEach((p) => { %>

<%
let nomorAktif = null;

if (p.sisa_stok > 0) {
  nomorAktif = activeIndex++;
}
%>

<tr

  data-kode="<%= (p.kode_produk || '').toLowerCase() %>"

  data-nama="<%= (p.nama || '').toLowerCase() %>"

  data-posisi="<%= (p.posisi || '').toLowerCase() %>">

  <!-- NOMOR -->
  <td class="text-center">

    <% if (nomorAktif) { %>

      <strong>
        <%= nomorAktif %>
      </strong>

    <% } else { %>

      -

    <% } %>

  </td>

  <!-- KODE -->
  <td class="text-center">

    <% if (nomorAktif) { %>

      <span class="badge bg-primary">

        P<%= nomorAktif %>

      </span>

    <% } else { %>

      <span class="badge bg-danger">

        SOLD

      </span>

    <% } %>

  </td>

  <!-- PRODUK -->
  <td>

    <strong>
      <%= p.nama || '-' %>
    </strong>

  </td>

  <!-- POSISI -->
  <td>

    <%= p.posisi || '-' %>

  </td>

  <!-- HARGA MODAL -->
  <td class="text-end">
    Rp <%= Number(p.harga_modal || 0).toLocaleString('id-ID') %>
  </td>

  <!-- STOK -->
  <td class="text-center">

    <span class="badge bg-primary">

      <%= p.stok_jakarta || 0 %>

    </span>

  </td>

  <!-- TERKIRIM -->
  <td class="text-center">

    <span class="badge bg-info text-dark">

      <%= p.keluar_ke_semarang || 0 %>

    </span>

  </td>

  <!-- SISA -->
  <td class="text-center">

    <% if (p.sisa_stok <= 0) { %>

      <span class="badge bg-danger">

        0

      </span>

    <% } else if (p.sisa_stok <= 2) { %>

      <span class="badge bg-warning text-dark">

        <%= p.sisa_stok %>

      </span>

    <% } else { %>

      <span class="badge bg-success">

        <%= p.sisa_stok %>

      </span>

    <% } %>

  </td>

  <!-- STATUS -->
  <td class="text-center">

    <% if (p.sisa_stok <= 0) { %>

      <span class="badge bg-danger">

        Sold Out

      </span>

    <% } else if (p.sisa_stok <= 2) { %>

      <span class="badge bg-warning text-dark">

        Hampir Habis

      </span>

    <% } else { %>

      <span class="badge bg-success">

        Aman

      </span>

    <% } %>

  </td>

  <!-- AKSI -->
  <td class="text-center">

    <% if (p.sisa_stok > 0) { %>

      <button
        class="btn btn-sm btn-primary"
        data-bs-toggle="modal"
        data-bs-target="#transferModal<%= p.id %>">

        Kirim

      </button>

    <% } else { %>

      <button
        class="btn btn-sm btn-secondary"
        disabled>

        Habis

      </button>

    <% } %>

  </td>

</tr>

<!-- MODAL -->
<div
  class="modal fade"
  id="transferModal<%= p.id %>"
  tabindex="-1"
  aria-hidden="true">

  <div class="modal-dialog">

    <div class="modal-content">

      <form action="/transfer-stock" method="POST">

        <div class="modal-header">

          <h5 class="modal-title">

            Transfer Stok

          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal">
          </button>

        </div>

        <div class="modal-body">

          <div class="mb-3">

            <label class="form-label">

              Produk

            </label>

            <input
              type="text"
              class="form-control"
              value="<%= p.nama %>"
              readonly>

          </div>

          <div class="mb-3">

            <label class="form-label">

              Sisa Stok Jakarta

            </label>

            <input
              type="text"
              class="form-control"
              value="<%= p.sisa_stok %>"
              readonly>

          </div>

          <input
            type="hidden"
            name="produk_id"
            value="<%= p.id %>">

          <input
            type="hidden"
            name="dari_cabang"
            value="1">

          <input
            type="hidden"
            name="ke_cabang"
            value="2">

          <div class="mb-3">

            <label class="form-label">

              Jumlah Kirim

            </label>

            <input
              type="number"
              name="jumlah"
              class="form-control"
              min="1"
              max="<%= p.sisa_stok %>"
              required>

          </div>

        </div>

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">

            Batal

          </button>

          <button
            type="submit"
            class="btn btn-primary">

            Kirim Sekarang

          </button>

        </div>

      </form>

    </div>

  </div>

</div>

<% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>

  // ============================================
  // SEARCH PRODUK
  // ============================================

  const searchInput =
    document.getElementById('searchInput');

  const rows =
    document.querySelectorAll(
      'tbody tr[data-kode]'
    );

  searchInput.addEventListener('input', function () {

    const keyword =
      this.value
        .toLowerCase()
        .trim();

    rows.forEach(row => {

      const kode =
        row.dataset.kode || '';

      const nama =
        row.dataset.nama || '';

      const posisi =
        row.dataset.posisi || '';

      const text =
        `${kode} ${nama} ${posisi}`;

      if (
        text.includes(keyword)
      ) {

        row.style.display = '';

      } else {

        row.style.display = 'none';

      }

    });

  });

</script>

</body>
</html>