<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tambah Sparepart</title>

    <link rel="icon" href="/drcom.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .preview {

            width: 180px;
            height: 180px;
            border: 1px dashed #ccc;
            border-radius: 10px;
            object-fit: cover;

        }
    </style>

</head>

<body class="bg-light">

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h4 class="mb-0">

                    <i class="bi bi-plus-circle"></i>

                    Tambah Sparepart

                </h4>

            </div>

            <div class="card-body">

                <form method="POST" action="/sparepart/tambah" enctype="multipart/form-data">

                    <div class="row">

                        <div class="col-md-8">

                            <div class="mb-3">

                                <label class="form-label">

                                    Nama Sparepart

                                </label>

                                <input type="text" name="nama" class="form-control" required>

                            </div>

                            <div class="row">

                                <div class="col-md-6">

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Kategori

                                        </label>

                                        <input type="text" name="kategori" class="form-control">

                                    </div>

                                </div>

                                <div class="col-md-6">

                                    <div class="mb-3">

                                        <label class="form-label">

                                            Posisi Rak

                                        </label>

                                        <input type="text" name="posisi" class="form-control">

                                    </div>

                                </div>

                            </div>

                            <div class="row">

                                <div class="col-md-4">

                                    <div class="mb-3">

                                        <label>

                                            Harga Modal

                                        </label>

                                        <input type="number" name="harga_modal" class="form-control" required>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="mb-3">

                                        <label>

                                            Harga Jual

                                        </label>

                                        <input type="number" name="harga_jual" class="form-control" required>

                                    </div>

                                </div>

                                <div class="col-md-4">

                                    <div class="mb-3">

                                        <label>

                                            Stok Awal

                                        </label>

                                        <input type="number" name="stok" class="form-control" required>

                                    </div>

                                </div>

                            </div>

                            <div class="mb-3">

                                <label>

                                    Keterangan

                                </label>

                                <textarea name="keterangan" class="form-control" rows="4"></textarea>

                            </div>

                        </div>

                        <div class="col-md-4">

                            <div class="text-center">

                                <img src="https://placehold.co/180x180?text=Preview" id="preview" class="preview">

                            </div>

                            <div class="mt-3">

                                <label>

                                    Foto Sparepart

                                </label>

                                <input type="file" name="gambar" accept="image/*" class="form-control" id="gambar">

                            </div>

                        </div>

                    </div>

                    <hr>

                    <div class="text-end">

                        <a href="/sparepart" class="btn btn-secondary">

                            Kembali

                        </a>

                        <button class="btn btn-primary">

                            Simpan

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script>

        gambar.onchange = function (e) {

            const file = e.target.files[0];

            if (file) {

                preview.src = URL.createObjectURL(file);

            }

        }

    </script>

</body>

</html>