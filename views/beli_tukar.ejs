<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">

    <title>Tukar Unit</title>
    <link rel="icon" href="/drcom.png" type="image/png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

    <style>
        .select2-container .select2-selection--single {
            height: 38px;
            padding-top: 4px;
        }

        .select2-selection__rendered {
            line-height: 28px !important;
        }

        .select2-selection__arrow {
            height: 38px !important;
        }

        .select2-results__option {
            padding: 10px;
        }
    </style>

</head>

<body>

    <div class="container mt-4">

        <h2 class="mb-4">

            🔄 Tukar Unit

        </h2>

        <div class="card mb-4">

            <div class="card-header bg-primary text-white">

                Data Pembelian Lama

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <label>Seller</label>

                        <input class="form-control" readonly value="<%= pembelian.nama_seller %>">

                    </div>

                    <div class="col-md-6">

                        <label>Toko</label>

                        <input class="form-control" readonly value="<%= pembelian.nama_toko %>">

                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-6">

                        <label>Produk Lama</label>

                        <input class="form-control" readonly value="<%= pembelian.produk_nama %>">

                    </div>

                    <div class="col-md-2">

                        <label>Jumlah</label>

                        <input class="form-control" readonly value="<%= pembelian.jumlah %>">

                    </div>

                    <div class="col-md-4">

                        <label>Harga Lama</label>

                        <input class="form-control" readonly
                            value="Rp <%= Number(pembelian.harga).toLocaleString('id-ID') %>">

                        <input type="hidden" id="hargaLama" value="<%= pembelian.harga %>">

                    </div>

                </div>

                <div class="row mt-3">

                    <div class="col-md-6">

                        <label>Keterangan</label>

                        <textarea class="form-control" rows="2" readonly><%= pembelian.keterangan %></textarea>

                    </div>

                    <div class="col-md-6">

                        <label>Posisi Pengambilan</label>

                        <input class="form-control" readonly value="<%= pembelian.posisi_pengambilan %>">

                    </div>

                </div>

            </div>

        </div>

        <form action="/beli/tukar/<%= pembelian.id %>" method="POST" enctype="multipart/form-data">

            <div class="card">

                <div class="card-header bg-success text-white">

                    Barang Pengganti

                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">

                            <label class="form-label">Produk Baru</label>

                            <select name="produk_baru_id" id="produkBaru" class="form-select" required>

                                <option value="">Cari Produk...</option>

                                <% produk.forEach(function(p){ %>

                                    <option value="<%= p.id %>" data-harga="<%= p.harga || 0 %>"
                                        data-jkt="<%= p.stok_jakarta %>" data-smg="<%= p.stok_semarang %>"
                                        data-kode="<%= p.kode_produk %>"
                                        data-text="<%= p.kode_produk %> | <%= p.nama %>">

                                        <%= p.kode_produk %> |
                                            <%= p.nama %> |
                                                Rp <%= Number(p.harga||0).toLocaleString('id-ID') %> |
                                                    JKT : <%= p.stok_jakarta %> |
                                                        SMG : <%= p.stok_semarang %>

                                    </option>

                                    <% }) %>

                            </select>

                            <div class="row mt-3">

                                <div class="col-md-4">

                                    <label>Stok Jakarta</label>

                                    <input id="stokJkt" class="form-control" readonly>

                                </div>

                                <div class="col-md-4">

                                    <label>Stok Semarang</label>

                                    <input id="stokSmg" class="form-control" readonly>

                                </div>

                                <div class="col-md-4">

                                    <label>Harga Default</label>

                                    <input id="hargaDefault" class="form-control" readonly>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-2">

                            <label>Jumlah</label>

                            <input type="number" name="jumlah" id="jumlah" class="form-control"
                                value="<%= pembelian.jumlah %>" required>

                        </div>

                        <div class="col-md-4">

                            <label>Harga Baru</label>

                            <input type="number" name="harga_baru" id="hargaBaru" class="form-control">

                        </div>

                        <div class="row mt-3">

                            <div class="col-md-6">

                                <label>Subtotal Baru</label>

                                <input id="subtotal" class="form-control" readonly>

                            </div>

                            <div class="col-md-6">

                                <label>Selisih Harga</label>

                                <input id="selisih" class="form-control" readonly>

                            </div>

                        </div>

                    </div>

                    <div class="mt-3">

                        <label>Alasan Tukar Unit</label>

                        <textarea name="alasan" class="form-control" rows="3" required></textarea>

                    </div>

                    <div class="mt-3">

                        <label>Keterangan</label>

                        <textarea name="keterangan" class="form-control" rows="3"></textarea>

                    </div>

                    <div class="mt-3">

                        <label>Upload Foto</label>

                        <input type="file" name="gambar" class="form-control">

                    </div>

                    <div class="mt-4 d-flex gap-2">

                        <button class="btn btn-success">

                            Simpan Tukar Unit

                        </button>

                        <a href="/" class="btn btn-secondary">

                            Kembali

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>

</body>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script>
    $(document).ready(function () {

        $('#produkBaru').select2({

            placeholder: "🔍 Cari kode atau nama produk",

            allowClear: true,

            width: '100%'

        });

    });
</script>
<script>
    window.onload = function () {
        hitung();
    };

    const produk = document.getElementById("produkBaru");

    const jumlah = document.getElementById("jumlah");

    const stokJkt = document.getElementById("stokJkt");

    const stokSmg = document.getElementById("stokSmg");

    const subtotal = document.getElementById("subtotal");

    const selisih = document.getElementById("selisih");

    const hargaDefault = document.getElementById("hargaDefault");

    function hitung() {

        const opt = $("#produkBaru option:selected");

        if (opt.val() == "") {

            subtotal.value = "";
            selisih.value = "";
            hargaDefault.value = "";
            stokJkt.value = "";
            stokSmg.value = "";
            return;

        }

        const defaultHarga = Number(opt.data("harga")) || 0;

        const stokJakarta = Number(opt.data("jkt")) || 0;

        const stokSemarang = Number(opt.data("smg")) || 0;

        stokJkt.value = stokJakarta;

        stokSmg.value = stokSemarang;

        hargaDefault.value =
            "Rp " + defaultHarga.toLocaleString("id-ID");

        if (harga.value == "")
            harga.value = defaultHarga;

        const qty = Number(jumlah.value) || 1;

        const hargaBaru = Number(harga.value) || 0;

        const hargaLama = Number($("#hargaLama").val()) || 0;

        subtotal.value =
            "Rp " + (hargaBaru * qty).toLocaleString("id-ID");

        const diff =
            (hargaBaru * qty) -
            (hargaLama * qty);

        if (diff > 0) {

            selisih.value =
                "Untung Rp " +
                diff.toLocaleString("id-ID");

        }

        else if (diff < 0) {

            selisih.value =
                "Rugi Rp " +
                Math.abs(diff).toLocaleString("id-ID");

        }

        else {

            selisih.value = "Impas";

        }

    }

    $('#produkBaru').on('change', function () {

        hitung();

    });

    harga.addEventListener("input", hitung);

    jumlah.addEventListener("input", hitung);

</script>
<script>

    document.querySelector("form").onsubmit = function () {

        const cabang =<%= pembelian.cabang_id %>;

        const stok =
            cabang == 1

                ? parseInt(stokJkt.value)

                : parseInt(stokSmg.value);

        const qty = parseInt(jumlah.value);

        if (qty > stok) {

            alert("Stok tidak mencukupi");

            return false;

        }

    };
</script>

</html>