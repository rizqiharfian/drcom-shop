
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Service User - DR.COM</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Edit Service User</h3>
        <a href="/" class="btn btn-secondary">Kembali</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form action="/service-user/edit/<%= service.id %>" method="POST" class="row g-3">

                <div class="col-md-6">
                    <label class="form-label">Nama Customer</label>
                    <input type="text" name="nama_customer" class="form-control"
                           value="<%= service.nama_customer || '' %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Nomor HP / WhatsApp</label>
                    <input type="text" name="no_hp" class="form-control"
                           value="<%= service.no_hp || '' %>">
                </div>

                <div class="col-md-6">
                    <label class="form-label">Nama Barang</label>
                    <input type="text" name="nama_barang" class="form-control"
                           value="<%= service.nama_barang || '' %>" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Teknisi</label>
                    <input type="text" name="teknisi" class="form-control"
                           value="<%= service.teknisi || '' %>">
                </div>

                <div class="col-12">
                    <label class="form-label">Keluhan Customer</label>
                    <textarea name="keluhan" class="form-control" rows="3" required><%= service.keluhan || '' %></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Tindakan Perbaikan</label>
                    <textarea name="tindakan" class="form-control" rows="3"><%= service.tindakan || '' %></textarea>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Biaya Service (Rp)</label>
                    <input type="number" name="biaya" class="form-control" min="0"
                           value="<%= service.biaya || 0 %>">
                </div>

                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select" required>
                        <option value="PENDING" <%= service.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                        <option value="PROSES" <%= service.status === 'PROSES' ? 'selected' : '' %>>Proses</option>
                        <option value="SELESAI" <%= service.status === 'SELESAI' ? 'selected' : '' %>>Selesai</option>
                        <option value="CANCEL" <%= service.status === 'CANCEL' ? 'selected' : '' %>>Cancel</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Tanggal Service</label>
                    <input type="datetime-local" name="tanggal" class="form-control"
                           value="<%= new Date(new Date(service.tanggal).getTime() - new Date(service.tanggal).getTimezoneOffset() * 60000).toISOString().slice(0,16) %>">
                </div>

                <div class="col-12">
                    <label class="form-label">Keterangan Tambahan</label>
                    <textarea name="keterangan" class="form-control" rows="2"><%= service.keterangan || '' %></textarea>
                </div>

                <div class="col-12">
                    <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                    <a href="/" class="btn btn-outline-secondary">Batal</a>
                </div>

            </form>
        </div>
    </div>
</div>

</body>
</html>
