<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tambah Pembelian</title>

  <link rel="icon" href="/drcom.png" type="image/png">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>

    body{
      background:#f5f7fb;
    }

    .card{
      border:none;
      border-radius:16px;
    }

    .form-control,
    .form-select{
      border-radius:10px;
    }

    .produk-info{
      font-size:13px;
      color:#666;
    }

  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-dark bg-dark mb-4">

  <div class="container-fluid">

    <a class="navbar-brand" href="/">
      ← Kembali
    </a>

    <span class="navbar-text text-white">
      Tambah Pembelian
    </span>

  </div>

</nav>

<div class="container">

  <div class="card shadow-sm">

    <div class="card-header bg-primary text-white">

      <h5 class="mb-0">
        Form Tambah Pembelian
      </h5>

    </div>

    <div class="card-body">

      <form
        method="POST"
        action="/beli"
        class="row g-3">

        <!-- SEARCH -->
        <div class="col-12">

          <label class="form-label">
            Cari Produk
          </label>

          <input
            type="text"
            id="searchProduk"
            class="form-control"
            placeholder="Cari kode / nama produk...">

        </div>

        <!-- PRODUK -->
        <div class="col-12">

          <label
            for="produk_id"
            class="form-label">

            Pilih Produk

          </label>

          <select
            name="produk_id"
            id="produk_id"
            class="form-select"
            required>

            <option value="">
              -- Pilih Produk --
            </option>

            <% produk.forEach(p => { %>

              <% if (p.total_stok > 0) { %>

                <option
                  value="<%= p.id %>"

                  data-search="
                    <%= (p.kode_tampil || '').toLowerCase() %>
                    <%= (p.nama || '').toLowerCase() %>
                    <%= (p.brand_name || '').toLowerCase() %>
                  ">

                  [<%= p.kode_tampil %>]
                  -

                  <%= p.nama %>

                  <% if (p.brand_name) { %>
                    | <%= p.brand_name %>
                  <% } %>

                  | Stok:
                  <%= p.total_stok %>

                </option>

              <% } %>

            <% }) %>

          </select>

          <div class="form-text">

            Hanya produk yang masih memiliki stok yang tampil.

          </div>

        </div>

        <!-- JUMLAH -->
        <div class="col-md-6">

          <label
            for="jumlah"
            class="form-label">

            Jumlah

          </label>

          <input
            type="number"
            name="jumlah"
            id="jumlah"
            class="form-control"
            min="1"
            required
            placeholder="Masukkan jumlah pembelian">

        </div>

        <!-- CUSTOMER -->
        <div class="col-md-6">

          <label
            for="customer"
            class="form-label">

            Nama Customer

          </label>

          <input
            type="text"
            name="customer"
            id="customer"
            class="form-control"
            required
            placeholder="Nama pembeli">

        </div>

        <!-- HARGA -->
        <div class="col-md-6">

          <label
            for="harga"
            class="form-label">

            Harga Jual

          </label>

          <input
            type="number"
            name="harga"
            id="harga"
            class="form-control"
            required
            placeholder="Harga jual">

        </div>

        <!-- MODAL -->
        <div class="col-md-6">

          <label
            for="harga_modal"
            class="form-label">

            Harga Modal

          </label>

          <input
            type="number"
            name="harga_modal"
            id="harga_modal"
            class="form-control"
            placeholder="Harga modal">

        </div>

        <!-- KETERANGAN -->
        <div class="col-12">

          <label
            for="keterangan"
            class="form-label">

            Keterangan

          </label>

          <textarea
            name="keterangan"
            id="keterangan"
            rows="3"
            class="form-control"
            placeholder="Catatan tambahan..."></textarea>

        </div>

        <!-- BUTTON -->
        <div class="col-12 d-flex justify-content-end">

          <button
            type="submit"
            class="btn btn-success px-4">

            Simpan Pembelian

          </button>

        </div>

      </form>

    </div>

  </div>

</div>

<script
  src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
</script>

<script>

// ==========================================
// SEARCH DROPDOWN PRODUK
// ==========================================

const searchInput =
  document.getElementById('searchProduk');

const produkSelect =
  document.getElementById('produk_id');

const allOptions =
  Array.from(
    produkSelect.querySelectorAll('option')
  );

searchInput.addEventListener('keyup', function(){

  const keyword =
    this.value
      .toLowerCase()
      .trim();

  produkSelect.innerHTML = '';

  // default option
  const defaultOption =
    document.createElement('option');

  defaultOption.value = '';

  defaultOption.textContent =
    '-- Pilih Produk --';

  produkSelect.appendChild(defaultOption);

  allOptions.forEach(option => {

    if (!option.value) return;

    const searchText =
      option.dataset.search || '';

    if (
      searchText.includes(keyword)
    ) {

      produkSelect.appendChild(
        option
      );

    }

  });

});

</script>

</body>
</html>