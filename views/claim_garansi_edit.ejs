<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>Edit Claim Garansi</title>

    <link rel="icon" href="/drcom.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">

    <style>

    .select2-container .select2-selection--single{
        height:38px;
        padding-top:4px;
    }

    .select2-selection__rendered{
        line-height:28px !important;
    }

    .select2-selection__arrow{
        height:38px !important;
    }

    </style>

</head>

<body>

<div class="container mt-4">

    <h2>Edit Claim Garansi</h2>

    <div class="card mt-3">

        <div class="card-header bg-warning">

            Edit Data Claim

        </div>

        <div class="card-body">

            <form
                action="/claim-garansi/edit/<%= claim.id %>"
                method="POST"
                enctype="multipart/form-data">

                <div class="mb-3">

                    <label>Produk</label>

                    <select
                        id="produkSelect"
                        name="produk_id"
                        class="form-select"
                        required>

                        <% produk.forEach(function(p){ %>

                            <option
                                value="<%= p.id %>"
                                <%= claim.produk_id==p.id ? 'selected' : '' %>>

                                <%= p.kode_produk %> |
                                <%= p.nama %> |
                                JKT : <%= p.stok_jakarta %> |
                                SMG : <%= p.stok_semarang %>

                            </option>

                        <% }) %>

                    </select>

                </div>

                <div class="mb-3">

                    <label>Nama Customer</label>

                    <input
                        type="text"
                        name="customer"
                        class="form-control"
                        value="<%= claim.customer %>"
                        required>

                </div>

                <div class="mb-3">

                    <label>Keluhan / Kendala</label>

                    <textarea
                        name="keluhan"
                        rows="4"
                        class="form-control"><%= claim.keluhan %></textarea>

                </div>

                <div class="mb-3">

                    <label>Status</label>

                    <select
                        name="status"
                        class="form-select">

                        <option
                            value="Menunggu"
                            <%= claim.status=='Menunggu' ? 'selected' : '' %>>

                            Menunggu

                        </option>

                        <option
                            value="Proses"
                            <%= claim.status=='Proses' ? 'selected' : '' %>>

                            Proses

                        </option>

                        <option
                            value="Gagal"
                            <%= claim.status=='Gagal' ? 'selected' : '' %>>

                            Gagal

                        </option>

                        <option
                            value="Selesai"
                            <%= claim.status=='Selesai' ? 'selected' : '' %>>

                            Selesai

                        </option>

                    </select>

                </div>

                <div class="mb-3">

                    <label>Foto Saat Ini</label>

                    <div>

                        <% if(claim.gambar){ %>

                            <% claim.gambar.split(',').forEach(function(img){ %>

                                <a
                                    href="/media/<%= img %>"
                                    target="_blank">

                                    <img
                                        src="/media/<%= img %>"
                                        width="120"
                                        class="img-thumbnail me-2 mb-2">

                                </a>

                            <% }) %>

                        <% }else{ %>

                            <p class="text-muted">

                                Tidak ada foto

                            </p>

                        <% } %>

                    </div>

                </div>

                <div class="mb-3">

                    <label>Upload Foto Baru</label>

                    <input
                        type="file"
                        name="gambar"
                        class="form-control"
                        multiple
                        accept="image/*">

                    <small class="text-muted">

                        Kosongkan jika tidak ingin mengganti foto.

                    </small>

                </div>

                <button
                    class="btn btn-success">

                    Simpan Perubahan

                </button>

                <a
                    href="/claim-garansi"
                    class="btn btn-secondary">

                    Kembali

                </a>

            </form>

        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>

$('#produkSelect').select2({

    width:'100%',

    placeholder:'Cari Produk'

});

</script>

</body>

</html>