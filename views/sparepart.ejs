<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Sparepart & Aksesoris</title>

<link rel="icon" href="/drcom.png">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>

<body class="bg-light">

<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Data Sparepart & Aksesoris</h2>

    <div>

      <button
        class="btn btn-success"
        data-bs-toggle="modal"
        data-bs-target="#modalTambah">

        Tambah Sparepart

      </button>

      <a href="/export/sparepart/pdf"target="_blank"class="btn btn-danger">
        Export PDF
      </a>

      <a href="/" class="btn btn-secondary">
        Kembali
      </a>

    </div>

  </div>

  <div class="card shadow-sm">

    <div class="card-body table-responsive">

      <table class="table table-bordered table-hover">

        <thead class="table-dark">

          <tr>
            <th>No</th>
            <th>Kode</th>
            <th>Nama</th>
            <th>Kategori</th>
            <th>Modal</th>
            <th>Jual</th>
            <th>Stok</th>
            <th>Posisi</th>
            <th class="text-center" width="180">Aksi</th>
          </tr>

        </thead>

        <tbody>

          <% sparepart.forEach((sp,index) => { %>

          <tr>

            <td><%= index+1 %></td>

            <td>
              <%= sp.kode_sparepart %>
            </td>

            <td>
              <%= sp.nama %>
            </td>

            <td>
              <%= sp.kategori %>
            </td>

            <td>
              Rp <%= Number(sp.harga_modal).toLocaleString('id-ID') %>
            </td>

            <td>
              Rp <%= Number(sp.harga_jual).toLocaleString('id-ID') %>
            </td>

            <td>
              <%= sp.stok %>
            </td>

            <td>
              <%= sp.posisi || '-' %>
            </td>

            <td class="text-center">

              <a
                href="/sparepart/edit/<%= sp.id %>"
                class="btn btn-warning btn-sm">

                Edit

              </a>

              <form
                action="/sparepart/hapus/<%= sp.id %>"
                method="POST"
                style="display:inline;">

                <button
                  class="btn btn-danger btn-sm"
                  onclick="return confirm('Hapus sparepart ini?')">

                  Hapus

                </button>

              </form>

            </td>

          </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>

<!-- MODAL TAMBAH -->

<div
class="modal fade"
id="modalTambah">

<div class="modal-dialog">

<div class="modal-content">

<form action="/sparepart/tambah" method="POST">

<div class="modal-header">
<h5>Tambah Sparepart</h5>
</div>

<div class="modal-body">

<input
type="text"
name="nama"
class="form-control mb-2"
placeholder="Nama Sparepart"
required>

<input
type="text"
name="kategori"
class="form-control mb-2"
placeholder="Kategori">

<input
type="number"
name="harga_modal"
class="form-control mb-2"
placeholder="Harga Modal">

<input
type="number"
name="harga_jual"
class="form-control mb-2"
placeholder="Harga Jual">

<input
type="number"
name="stok"
class="form-control mb-2"
placeholder="Stok">

<input
type="text"
name="posisi"
class="form-control mb-2"
placeholder="Posisi">

<textarea
name="keterangan"
class="form-control"
placeholder="Keterangan"></textarea>

</div>

<div class="modal-footer">

<button
type="submit"
class="btn btn-success">

Simpan

</button>

</div>

</form>

</div>

</div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>