<!DOCTYPE html>
<html lang="id">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Edit Sparepart</title>

  <link rel="icon" href="/drcom.png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    .preview {

      width: 180px;
      height: 180px;
      border: 1px solid #ddd;
      border-radius: 10px;
      object-fit: cover;

    }
  </style>

</head>

<body class="bg-light">

  <div class="container mt-4">

    <div class="card shadow">

      <div class="card-header bg-warning">

        <h4>

          <i class="bi bi-pencil-square"></i>

          Edit Sparepart

        </h4>

      </div>

      <div class="card-body">

        <form action="/sparepart/edit/<%= sparepart.id %>" method="POST" enctype="multipart/form-data">

          <div class="row">

            <div class="col-md-8">

              <div class="mb-3">

                <label>Kode Sparepart</label>

                <input type="text" class="form-control" value="<%= sparepart.kode_sparepart %>" readonly>

              </div>

              <div class="mb-3">

                <label>Nama Sparepart</label>

                <input type="text" name="nama" class="form-control" value="<%= sparepart.nama %>" required>

              </div>

              <div class="row">

                <div class="col-md-6">

                  <div class="mb-3">

                    <label>Kategori</label>

                    <input type="text" name="kategori" class="form-control" value="<%= sparepart.kategori %>">

                  </div>

                </div>

                <div class="col-md-6">

                  <div class="mb-3">

                    <label>Posisi</label>

                    <input type="text" name="posisi" class="form-control" value="<%= sparepart.posisi %>">

                  </div>

                </div>

              </div>

              <div class="row">

                <div class="col-md-4">

                  <label>Harga Modal</label>

                  <input type="number" name="harga_modal" class="form-control" value="<%= sparepart.harga_modal %>">

                </div>

                <div class="col-md-4">

                  <label>Harga Jual</label>

                  <input type="number" name="harga_jual" class="form-control" value="<%= sparepart.harga_jual %>">

                </div>

                <div class="col-md-4">

                  <label>Stok</label>

                  <input type="number" name="stok" class="form-control" value="<%= sparepart.stok %>">

                </div>

              </div>

              <div class="mt-3">

                <label>Keterangan</label>

                <textarea name="keterangan" class="form-control" rows="4"><%= sparepart.keterangan %></textarea>

              </div>

            </div>

            <div class="col-md-4 text-center">

              <% if(sparepart.gambar){ %>

                <img id="preview" class="preview" src="/media/<%= sparepart.gambar %>">

                <% }else{ %>

                  <img id="preview" class="preview" src="https://placehold.co/180x180?text=Preview">

                  <% } %>

                    <div class="mt-3">

                      <label>Ganti Gambar</label>

                      <input type="file" name="gambar" id="gambar" class="form-control" accept="image/*">

                    </div>

            </div>

          </div>

          <hr>

          <div class="text-end">

            <a href="/sparepart" class="btn btn-secondary">

              Kembali

            </a>

            <button class="btn btn-warning">

              Update

            </button>

          </div>

        </form>

      </div>

    </div>

  </div>

  <script>

    gambar.onchange = function (e) {

      const file = e.target.files[0];

      if (file) {

        preview.src = URL.createObjectURL(file);

      }

    }

  </script>

</body>

</html>