<!DOCTYPE html>
<html lang="id">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Detail Sparepart</title>

    <link rel="icon" href="/drcom.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        .foto {

            width: 100%;
            height: 350px;
            object-fit: cover;
            border-radius: 12px;
            border: 1px solid #ddd;

        }

        .table td {

            vertical-align: middle;

        }
    </style>

</head>

<body class="bg-light">

    <div class="container mt-4">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">

                <h4>

                    <i class="bi bi-tools"></i>

                    Detail Sparepart

                </h4>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4">

                        <% if(sparepart.gambar){ %>

                            <img src="/media/<%= sparepart.gambar %>" class="foto">

                            <% }else{ %>

                                <img src="https://placehold.co/500x500?text=No+Image" class="foto">

                                <% } %>

                    </div>

                    <div class="col-md-8">

                        <table class="table table-bordered">

                            <tr>

                                <th width="220">Kode Sparepart</th>

                                <td>

                                    <%= sparepart.kode_sparepart %>

                                </td>

                            </tr>

                            <tr>

                                <th>Nama Sparepart</th>

                                <td>

                                    <%= sparepart.nama %>

                                </td>

                            </tr>

                            <tr>

                                <th>Kategori</th>

                                <td>

                                    <%= sparepart.kategori || '-' %>

                                </td>

                            </tr>

                            <tr>

                                <th>Harga Modal</th>

                                <td>

                                    Rp <%= Number(sparepart.harga_modal).toLocaleString('id-ID') %>

                                </td>

                            </tr>

                            <tr>

                                <th>Harga Jual</th>

                                <td>

                                    Rp <%= Number(sparepart.harga_jual).toLocaleString('id-ID') %>

                                </td>

                            </tr>

                            <tr>

                                <th>Stok</th>

                                <td>

                                    <% if(sparepart.stok>10){ %>

                                        <span class="badge bg-success">

                                            <%= sparepart.stok %>

                                        </span>

                                        <% }else if(sparepart.stok>0){ %>

                                            <span class="badge bg-warning text-dark">

                                                <%= sparepart.stok %>

                                            </span>

                                            <% }else{ %>

                                                <span class="badge bg-danger">

                                                    Habis

                                                </span>

                                                <% } %>

                                </td>

                            </tr>

                            <tr>

                                <th>Posisi</th>

                                <td>

                                    <%= sparepart.posisi || "-" %>

                                </td>

                            </tr>

                            <tr>

                                <th>Keterangan</th>

                                <td>

                                    <%= sparepart.keterangan || "-" %>

                                </td>

                            </tr>

                            <tr>

                                <th>Dibuat</th>

                                <td>

                                    <%= new Date(sparepart.created_at).toLocaleString('id-ID') %>

                                </td>

                            </tr>

                        </table>

                    </div>

                </div>

                <hr>

                <div class="text-end">

                    <a href="/sparepart" class="btn btn-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Kembali

                    </a>

                    <a href="/sparepart/edit/<%= sparepart.id %>" class="btn btn-warning">

                        <i class="bi bi-pencil"></i>

                        Edit

                    </a>

                    <form action="/sparepart/delete/<%= sparepart.id %>" method="POST" class="d-inline">

                        <button class="btn btn-danger" onclick="return confirm('Yakin ingin menghapus sparepart ini?')">

                            <i class="bi bi-trash"></i>

                            Hapus

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</body>

</html>