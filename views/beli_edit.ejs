<!DOCTYPE html>
<html lang="id">

<head>

<meta charset="UTF-8">

<title>Edit Pembelian</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

</head>

<body class="bg-light">

<div class="container mt-4">

<div class="card shadow">

<div class="card-header bg-warning">

<h4>Edit Pembelian</h4>

</div>

<div class="card-body">

<form action="/beli/edit/<%= pembelian.id %>" method="POST" enctype="multipart/form-data">

<div class="row">

<div class="col-md-3 mb-3">

<label>Seller</label>

<select name="seller_id" id="seller_id" class="form-select">

<% seller.forEach(s=>{ %>

<option value="<%= s.id %>"

<%= s.id==pembelian.seller_id ? "selected":"" %>>

<%= s.nama_seller %>

</option>

<% }) %>

</select>

</div>

<div class="col-md-3 mb-3">

<label>Toko</label>

<select name="toko_id" id="toko_id" class="form-select">

<% toko.forEach(t=>{ %>

<option value="<%= t.id %>"

<%= t.id==pembelian.toko_id ? "selected":"" %>>

<%= t.nama_toko %>

</option>

<% }) %>

</select>

</div>

<div class="col-md-6 mb-3">

<label>Produk</label>

<select name="produk_id" id="produk_id" class="form-select">

<% produk.forEach(p=>{ %>

<option value="<%= p.id %>"

<%= p.id==pembelian.produk_id ? "selected":"" %>>

<%= p.nama %>

|

JKT : <%= p.stok_jakarta %>

|

SMG : <%= p.stok_semarang %>

</option>

<% }) %>

</select>

</div>

<div class="col-md-3 mb-3">

<label>Cabang</label>

<select name="cabang_id" class="form-select">

<option value="1" <%= pembelian.cabang_id==1?"selected":"" %>>

Jakarta

</option>

<option value="2" <%= pembelian.cabang_id==2?"selected":"" %>>

Semarang

</option>

</select>

</div>

<div class="col-md-3 mb-3">

<label>Jumlah</label>

<input
type="number"
name="jumlah"
class="form-control"
value="<%= pembelian.jumlah %>">

</div>

<div class="col-md-3 mb-3">

<label>Harga Modal</label>

<input
type="number"
name="harga_modal"
class="form-control"
value="<%= pembelian.harga_modal %>">

</div>

<div class="col-md-3 mb-3">

<label>Harga</label>

<input
type="number"
name="harga"
class="form-control"
value="<%= pembelian.harga %>">

</div>

<div class="col-md-6 mb-3">

<label>Posisi Pengambilan</label>

<input
type="text"
name="posisi_pengambilan"
class="form-control"
value="<%= pembelian.posisi_pengambilan || '' %>">

</div>

<div class="col-md-6 mb-3">

<label>Keterangan</label>

<input
type="text"
name="keterangan"
class="form-control"
value="<%= pembelian.keterangan || '' %>">

</div>

<div class="col-md-6">

<label>Gambar Lama</label>

<br>

<% if(pembelian.gambar){ %>

<img
src="/media/<%= pembelian.gambar %>"
style="max-width:250px"
class="img-thumbnail">

<% }else{ %>

<p class="text-muted">

Belum ada gambar

</p>

<% } %>

</div>

<div class="col-md-6">

<label>Ganti Gambar</label>

<input
type="file"
name="gambar"
class="form-control">

</div>

<div class="col-12 mt-4 text-end">

<a
href="/"
class="btn btn-secondary">

Kembali

</a>

<button
class="btn btn-success">

Simpan Perubahan

</button>

</div>

</div>

</form>

</div>

</div>

</div>

<script>

$("#produk_id").select2({

width:'100%',

placeholder:'Cari Produk'

});

</script>

</body>

</html>