<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Stok Semarang</title>
  <link rel="icon" href="/drcom.png" type="image/png">

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <style>
    .table td,
    .table th {
      vertical-align: middle;
    }

    .harga-modal {
      min-width: 140px;
      text-align: right;
      font-weight: 600;
    }
  </style>

</head>
<body class="bg-light">

<div class="container py-4">

  <div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Stok Cabang Semarang</h2>
    <div class="card shadow-sm mb-6">

        <div class="card-body">

            <div class="row g-2">

            <!-- SEARCH -->
            <div class="col-md-5">

                <input
                type="text"
                id="searchInput"
                class="form-control"
                placeholder="Cari produk...">

            </div>

            <!-- TAMBAH PRODUK -->
            <div class="col-md-7 text-end">

                <button
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#modalTambahProdukSemarang">

                Tambah Produk

                </button>

            </div>

            </div>

        </div>

        </div>

    <div>
      <a href="/stok/jakarta" class="btn btn-primary me-2">Cabang Jakarta</a>
      <a href="/produk" class="btn btn-warning me-2">Semua Stok Pusat</a>
      <a href="/stok/semarang/export-pdf" class="btn btn-danger me-2">Export PDF</a>
      <a href="/" class="btn btn-secondary">Kembali</a>
    </div>

  </div>

  <div class="card shadow-sm">

    <div class="card-body table-responsive">

      <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark text-center">

          <tr>
            <th>No</th>
            <th>Kode</th>
            <th>Produk</th>
            <!-- <th>Harga Modal</th> -->
            <th>Stok Semarang</th>
            <th>Status</th>
            <th width="220">Aksi</th>
          </tr>

        </thead>

        <tbody>

          <% produk.forEach((p, index) => { %>

            <tr class="produk-row"
              data-nama="<%= (p.nama || '').toLowerCase() %>"
              data-kode="<%= (p.kode_produk || '').toLowerCase() %>">

              <td class="text-center">
                <%= index + 1 %>
              </td>
              <td><%= p.kode_produk || '-' %></td>
              <td><%= p.nama || '-' %></td>

              <!-- <td class="harga-modal">
                Rp <%= Number(p.harga_modal || 0).toLocaleString('id-ID') %>
              </td> -->

              <td class="text-center">
                <% if (p.stok_semarang <= 0) { %>
                  <span class="badge bg-danger">0</span>
                <% } else if (p.stok_semarang <= 2) { %>
                  <span class="badge bg-warning text-dark"><%= p.stok_semarang %></span>
                <% } else { %>
                  <span class="badge bg-success"><%= p.stok_semarang %></span>
                <% } %>
              </td>

              <td class="text-center">
                <% if (p.stok_semarang <= 0) { %>
                  <span class="badge bg-danger">Sold Out</span>
                <% } else if (p.stok_semarang <= 2) { %>
                  <span class="badge bg-warning text-dark">Hampir Habis</span>
                <% } else { %>
                  <span class="badge bg-success">Aman</span>
                <% } %>
              </td>

              <td class="text-center">
                <a href="/stok-semarang/lihat/<%= p.id %>" class="btn btn-info btn-sm">Lihat</a>
                <a href="/stok-semarang/edit/<%= p.id %>" class="btn btn-warning btn-sm">Edit</a>
                <form action="/stok-semarang/hapus/<%= p.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Yakin hapus produk ini?')">
                  <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                </form>
              </td>

            </tr>

          <% }) %>

        </tbody>

      </table>

    </div>

  </div>

</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>

const searchInput = document.getElementById('searchInput');

searchInput.addEventListener('keyup', function() {

  const keyword = this.value.toLowerCase();

  document.querySelectorAll('.produk-row').forEach(row => {

    const nama = row.dataset.nama || '';
    const kode = row.dataset.kode || '';

    if (
      nama.includes(keyword) ||
      kode.includes(keyword)
    ) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }

  });

});

</script>
<!-- Modal Tambah Produk Semarang -->
<div 
  class="modal fade"
  id="modalTambahProdukSemarang"
  tabindex="-1"
  aria-hidden="true">

  <div class="modal-dialog">

    <div class="modal-content">

      <form action="/stok-semarang/tambah" method="POST">

        <div class="modal-header">

          <h5 class="modal-title">
            Tambah Produk Semarang
          </h5>

          <button
            type="button"
            class="btn-close"
            data-bs-dismiss="modal">
          </button>

        </div>

        <div class="modal-body">

          <div class="mb-3">

            <label class="form-label">
              Kode Produk
            </label>

            <input
              type="text"
              name="kode_produk"
              class="form-control"
              required>

          </div>

          <div class="mb-3">

            <label class="form-label">
              Nama Produk
            </label>

            <input
              type="text"
              name="nama"
              class="form-control"
              required>

          </div>

          <div class="mb-3">

            <label class="form-label">
              Jumlah Stok
            </label>

            <input
              type="number"
              name="stok"
              class="form-control"
              min="1"
              required>

          </div>

          <div class="mb-3">

            <label class="form-label">
              Posisi
            </label>

            <input
              type="text"
              name="posisi"
              class="form-control">

          </div>

        </div>

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-secondary"
            data-bs-dismiss="modal">

            Batal
          </button>

          <button
            type="submit"
            class="btn btn-success">

            Simpan
          </button>

        </div>

      </form>

    </div>

  </div>

</div>
</body>
</html>